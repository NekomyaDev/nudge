/// Master Unified In-Memory Index Engine & Pipeline Orchestrator
/// Part of Phase 6 (v2.6) - Unified Autonomous Index Engine & Event Debouncer
/// Zero foreign dependencies - 100% Pure Nudge

type EngineSymbol = {
    name: string,
    kind: string,
    file_path: string,
    line: int,
    signature: string,
    body: string,
    sig_hash: string,
    body_hash: string,
    effects: [string]
}

type EngineEdge = {
    caller: string,
    callee: string,
    file_path: string
}

type EnginePosting = {
    term: string,
    file_path: string,
    symbol: string
}

type EngineDiff = {
    symbol: string,
    diff_kind: string,
    file_path: string,
    is_breaking: bool,
    blast_radius: [string]
}

type EngineStats = {
    file_count: int,
    symbol_count: int,
    edge_count: int,
    posting_count: int,
    mutation_events: int
}

fn contains_engine_str(xs: [string], target: string) -> bool {
    let mut found = false
    for x in xs {
        if x == target {
            found = true
        }
    }
    found
}

fn compute_engine_hash(text: string) -> string {
    let raw = str.hash(text)
    let pos = if raw < 0 { -raw } else { raw }
    "h_" + str.to_string(pos)
}

// ── Agents with Unique Method Names ──────────────────────────────────

agent EngineVfs {
    state {
        files: [string] = []
        file_contents: [string] = []
    }

    fn vfs_clear() {
        state.files = []
        state.file_contents = []
    }

    fn vfs_write_file(path: string, content: string) {
        let mut new_files: [string] = []
        let mut new_contents: [string] = []
        let mut replaced = false

        for (f, idx) in state.files {
            if f == path {
                new_files = new_files + [path]
                new_contents = new_contents + [content]
                replaced = true
            } else {
                new_files = new_files + [f]
                new_contents = new_contents + [state.file_contents[idx]]
            }
        }

        if !replaced {
            new_files = new_files + [path]
            new_contents = new_contents + [content]
        }

        state.files = new_files
        state.file_contents = new_contents
    }

    fn vfs_read_file(path: string) -> string? {
        let mut found: string? = none
        for (f, idx) in state.files {
            if f == path {
                found = state.file_contents[idx]
            }
        }
        found
    }

    fn vfs_delete_file(path: string) -> bool {
        let mut new_files: [string] = []
        let mut new_contents: [string] = []
        let mut removed = false

        for (f, idx) in state.files {
            if f == path {
                removed = true
            } else {
                new_files = new_files + [f]
                new_contents = new_contents + [state.file_contents[idx]]
            }
        }

        if removed {
            state.files = new_files
            state.file_contents = new_contents
        }
        removed
    }

    fn vfs_count() -> int {
        len(state.files)
    }
}

agent EngineSymbolTable {
    state {
        symbols: [EngineSymbol] = []
    }

    fn sym_clear() {
        state.symbols = []
    }

    fn sym_insert(s: EngineSymbol) {
        let mut updated: [EngineSymbol] = []
        let mut replaced = false
        for sym in state.symbols {
            if sym.name == s.name {
                updated = updated + [s]
                replaced = true
            } else {
                updated = updated + [sym]
            }
        }
        if !replaced {
            updated = updated + [s]
        }
        state.symbols = updated
    }

    fn sym_lookup(name: string) -> EngineSymbol? {
        let mut found: EngineSymbol? = none
        for s in state.symbols {
            if s.name == name {
                found = s
            }
        }
        found
    }

    fn sym_remove(name: string) -> bool {
        let mut updated: [EngineSymbol] = []
        let mut removed = false
        for s in state.symbols {
            if s.name == name {
                removed = true
            } else {
                updated = updated + [s]
            }
        }
        if removed {
            state.symbols = updated
        }
        removed
    }

    fn sym_count() -> int {
        len(state.symbols)
    }
}

agent EngineCallGraph {
    state {
        edges: [EngineEdge] = []
    }

    fn cg_clear() {
        state.edges = []
    }

    fn cg_add_edge(caller: string, callee: string, path: string) {
        let mut exists = false
        for e in state.edges {
            if e.caller == caller and e.callee == callee {
                exists = true
            }
        }
        if !exists {
            let edge: EngineEdge = { caller: caller, callee: callee, file_path: path }
            state.edges = state.edges + [edge]
        }
    }

    fn cg_remove_caller(caller: string) {
        let mut remaining: [EngineEdge] = []
        for e in state.edges {
            if e.caller != caller {
                remaining = remaining + [e]
            }
        }
        state.edges = remaining
    }

    fn cg_get_callers(callee: string) -> [string] {
        let mut callers: [string] = []
        for e in state.edges {
            if e.callee == callee {
                if !contains_engine_str(callers, e.caller) {
                    callers = callers + [e.caller]
                }
            }
        }
        callers
    }

    fn cg_blast_radius(root: string, max_depth: int) -> [string] {
        let mut visited: [string] = []
        let mut frontier: [string] = [root]

        for _hop in [1, 2, 3, 4, 5] {
            if _hop <= max_depth and len(frontier) > 0 {
                let mut next_frontier: [string] = []
                for node in frontier {
                    let direct = EngineCallGraph.cg_get_callers(node)
                    for caller in direct {
                        if !contains_engine_str(visited, caller) and caller != root {
                            visited = visited + [caller]
                            next_frontier = next_frontier + [caller]
                        }
                    }
                }
                frontier = next_frontier
            }
        }
        visited
    }

    fn cg_count() -> int {
        len(state.edges)
    }
}

agent EngineInvertedIndex {
    state {
        postings: [EnginePosting] = []
    }

    fn idx_clear() {
        state.postings = []
    }

    fn idx_add(term: string, path: string, sym: string) {
        let clean = str.trim(str.lower(term))
        if clean != "" {
            let p: EnginePosting = { term: clean, file_path: path, symbol: sym }
            state.postings = state.postings + [p]
        }
    }

    fn idx_search(q: string) -> [string] {
        let query = str.trim(str.lower(q))
        let mut matched: [string] = []
        for p in state.postings {
            if p.term == query or str.contains(p.term, query) {
                if !contains_engine_str(matched, p.symbol) {
                    matched = matched + [p.symbol]
                }
            }
        }
        matched
    }

    fn idx_count() -> int {
        len(state.postings)
    }
}

// ── Master Engine Public Orchestrator ────────────────────────────────

fn engine_init() {
    EngineVfs.vfs_clear()
    EngineSymbolTable.sym_clear()
    EngineCallGraph.cg_clear()
    EngineInvertedIndex.idx_clear()
}

fn engine_mount_file(path: string, content: string) {
    EngineVfs.vfs_write_file(path, content)
}

fn engine_register_declaration(
    path: string,
    name: string,
    kind: string,
    line: int,
    signature: string,
    body: string,
    effects: [string],
    callees: [string]
) -> EngineDiff {
    let old_opt = EngineSymbolTable.sym_lookup(name)
    let s_hash = compute_engine_hash(signature)
    let b_hash = compute_engine_hash(body)
    let blast = EngineCallGraph.cg_blast_radius(name, 5)

    let mut kind_event = "DECLARATION_ADDED"
    let mut breaking = false

    if old_opt != none {
        let old = old_opt
        if old.sig_hash != s_hash {
            kind_event = "SIGNATURE_MUTATED"
            breaking = true
        } else if old.body_hash != b_hash {
            kind_event = "BODY_MUTATED"
            breaking = false
        } else {
            kind_event = "UNCHANGED"
            breaking = false
        }
    }

    let sym: EngineSymbol = {
        name: name,
        kind: kind,
        file_path: path,
        line: line,
        signature: signature,
        body: body,
        sig_hash: s_hash,
        body_hash: b_hash,
        effects: effects
    }

    EngineSymbolTable.sym_insert(sym)

    // Update postings
    EngineInvertedIndex.idx_add(name, path, name)
    let parts = str.split(name, "_")
    for p in parts {
        if p != "" {
            EngineInvertedIndex.idx_add(p, path, name)
        }
    }

    // Refresh dependencies
    EngineCallGraph.cg_remove_caller(name)
    for c in callees {
        EngineCallGraph.cg_add_edge(name, c, path)
    }

    {
        symbol: name,
        diff_kind: kind_event,
        file_path: path,
        is_breaking: breaking,
        blast_radius: if breaking { blast } else { [] }
    }
}

fn engine_delete_declaration(name: string) -> EngineDiff {
    let blast = EngineCallGraph.cg_blast_radius(name, 5)
    let _rem = EngineSymbolTable.sym_remove(name)
    EngineCallGraph.cg_remove_caller(name)

    {
        symbol: name,
        diff_kind: "DECLARATION_REMOVED",
        file_path: "",
        is_breaking: true,
        blast_radius: blast
    }
}

fn engine_lookup(name: string) -> EngineSymbol? {
    EngineSymbolTable.sym_lookup(name)
}

fn engine_callers(name: string) -> [string] {
    EngineCallGraph.cg_get_callers(name)
}

fn engine_blast_radius(name: string) -> [string] {
    EngineCallGraph.cg_blast_radius(name, 5)
}

fn engine_search(query: string) -> [string] {
    EngineInvertedIndex.idx_search(query)
}

fn engine_stats() -> EngineStats {
    {
        file_count: EngineVfs.vfs_count(),
        symbol_count: EngineSymbolTable.sym_count(),
        edge_count: EngineCallGraph.cg_count(),
        posting_count: EngineInvertedIndex.idx_count(),
        mutation_events: 0
    }
}

fn main() -> int {
    engine_init()
    engine_mount_file("/core/math.ndg", "fn add(a: int, b: int) -> int { a + b }")
    let diff = engine_register_declaration(
        "/core/math.ndg",
        "add",
        "fn",
        1,
        "fn add(a: int, b: int) -> int",
        "a + b",
        [],
        []
    )
    if diff.diff_kind == "DECLARATION_ADDED" and !diff.is_breaking {
        0
    } else {
        1
    }
}
