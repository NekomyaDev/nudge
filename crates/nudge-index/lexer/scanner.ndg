/// Pure-Nudge State-Machine Scanner & Lexer
/// Part of Phase 3 (v2.3) - Lexer & Full-Spectrum AST Parser
/// Zero foreign dependencies - 100% Pure Nudge

type Token = {
    kind: string,
    text: string,
    line: int,
    col: int,
    offset: int,
    length: int
}

fn is_digit_code(c: int) -> bool {
    c >= 48 and c <= 57
}

fn is_alpha_code(c: int) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}

fn is_alphanumeric_code(c: int) -> bool {
    is_alpha_code(c) or is_digit_code(c)
}

fn is_kw(s: string) -> bool {
    let kw = [
        "fn", "agent", "tool", "type", "view", "window", "decide", "auth",
        "provider", "account", "uses", "costs", "retry", "with", "repair",
        "state", "test", "for_all", "gen", "let", "mut", "if", "else",
        "for", "in", "return", "assert", "none", "true", "false", "and",
        "or", "not", "par", "race", "map", "merge", "route", "stream",
        "impl", "mcp", "side_effects"
    ]
    let mut found = false
    for k in kw {
        if k == s {
            found = true
        }
    }
    found
}

fn scan_tokens(src: string) -> [Token] {
    let n = str.length(src)
    let chars = str.split(src, "")
    let mut tokens: [Token] = []
    let mut pos = 0
    let mut line = 1
    let mut col = 1

    for _ in chars {
        if pos < n {
            let c = str.char_code(src, pos)

            // Whitespace handling
            if c == 32 or c == 9 or c == 13 {
                pos = pos + 1
                col = col + 1
            } else if c == 10 {
                pos = pos + 1
                line = line + 1
                col = 1
            } else if c == 47 and pos + 1 < n and str.char_code(src, pos + 1) == 47 {
                // Single-line comment //
                pos = pos + 2
                col = col + 2
                let mut in_comment = true
                for _ in chars {
                    if pos < n and in_comment {
                        let cc = str.char_code(src, pos)
                        if cc == 10 {
                            in_comment = false
                            pos = pos + 1
                            line = line + 1
                            col = 1
                        } else {
                            pos = pos + 1
                            col = col + 1
                        }
                    }
                }
            } else if c == 47 and pos + 1 < n and str.char_code(src, pos + 1) == 42 {
                // Multi-line comment /* ... */
                pos = pos + 2
                col = col + 2
                let mut in_block = true
                for _ in chars {
                    if pos < n and in_block {
                        let cc = str.char_code(src, pos)
                        if cc == 10 {
                            pos = pos + 1
                            line = line + 1
                            col = 1
                        } else if cc == 42 and pos + 1 < n and str.char_code(src, pos + 1) == 47 {
                            pos = pos + 2
                            col = col + 2
                            in_block = false
                        } else {
                            pos = pos + 1
                            col = col + 1
                        }
                    }
                }
            } else if c == 108 and pos + 5 < n and str.substring(src, pos, pos + 6) == "llm\"\"\"" {
                // Multi-line Prompt Literal: llm"""...""" (Prompt Shielding)
                let start_pos = pos
                let start_col = col
                let start_line = line
                pos = pos + 6
                col = col + 6
                let mut in_prompt = true
                let mut prompt_content = ""
                for _ in chars {
                    if pos < n and in_prompt {
                        if pos + 2 < n and str.substring(src, pos, pos + 3) == "\"\"\"" {
                            pos = pos + 3
                            col = col + 3
                            in_prompt = false
                        } else {
                            let ch_code = str.char_code(src, pos)
                            if ch_code == 10 {
                                line = line + 1
                                col = 1
                            } else {
                                col = col + 1
                            }
                            prompt_content = prompt_content + str.substring(src, pos, pos + 1)
                            pos = pos + 1
                        }
                    }
                }
                tokens = tokens + [{
                    kind: "prompt",
                    text: prompt_content,
                    line: start_line,
                    col: start_col,
                    offset: start_pos,
                    length: pos - start_pos
                }]
            } else if c == 34 {
                // String literal "..."
                let start_pos = pos
                let start_col = col
                let start_line = line
                pos = pos + 1
                col = col + 1
                let mut in_str = true
                let mut content = ""
                for _ in chars {
                    if pos < n and in_str {
                        let sc = str.char_code(src, pos)
                        if sc == 34 {
                            pos = pos + 1
                            col = col + 1
                            in_str = false
                        } else if sc == 92 and pos + 1 < n {
                            // Escape
                            let next_c = str.char_code(src, pos + 1)
                            if next_c == 110 { content = content + "\n" }
                            else if next_c == 116 { content = content + "\t" }
                            else if next_c == 34 { content = content + "\"" }
                            else if next_c == 92 { content = content + "\\" }
                            else { content = content + str.substring(src, pos + 1, pos + 2) }
                            pos = pos + 2
                            col = col + 2
                        } else {
                            if sc == 10 {
                                line = line + 1
                                col = 1
                            } else {
                                col = col + 1
                            }
                            content = content + str.substring(src, pos, pos + 1)
                            pos = pos + 1
                        }
                    }
                }
                tokens = tokens + [{
                    kind: "string",
                    text: content,
                    line: start_line,
                    col: start_col,
                    offset: start_pos,
                    length: pos - start_pos
                }]
            } else if is_digit_code(c) {
                // Number literal (int or float)
                let start_pos = pos
                let start_col = col
                let mut is_float = false
                let mut reading_num = true
                for _ in chars {
                    if pos < n and reading_num {
                        let nc = str.char_code(src, pos)
                        if is_digit_code(nc) {
                            pos = pos + 1
                            col = col + 1
                        } else if nc == 46 and !is_float and pos + 1 < n and is_digit_code(str.char_code(src, pos + 1)) {
                            is_float = true
                            pos = pos + 1
                            col = col + 1
                        } else {
                            reading_num = false
                        }
                    }
                }
                let num_str = str.substring(src, start_pos, pos)
                let kind = if is_float { "float" } else { "int" }
                tokens = tokens + [{
                    kind: kind,
                    text: num_str,
                    line: line,
                    col: start_col,
                    offset: start_pos,
                    length: pos - start_pos
                }]
            } else if is_alpha_code(c) {
                // Identifier or Keyword
                let start_pos = pos
                let start_col = col
                let mut reading_id = true
                for _ in chars {
                    if pos < n and reading_id {
                        let ic = str.char_code(src, pos)
                        if is_alphanumeric_code(ic) {
                            pos = pos + 1
                            col = col + 1
                        } else {
                            reading_id = false
                        }
                    }
                }
                let ident_str = str.substring(src, start_pos, pos)
                let kind = if is_kw(ident_str) { ident_str } else { "ident" }
                tokens = tokens + [{
                    kind: kind,
                    text: ident_str,
                    line: line,
                    col: start_col,
                    offset: start_pos,
                    length: pos - start_pos
                }]
            } else {
                // Two-character operators
                let start_pos = pos
                let start_col = col
                if pos + 1 < n and str.substring(src, pos, pos + 2) == "->" {
                    tokens = tokens + [{ kind: "->", text: "->", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else if pos + 1 < n and str.substring(src, pos, pos + 2) == "==" {
                    tokens = tokens + [{ kind: "==", text: "==", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else if pos + 1 < n and str.substring(src, pos, pos + 2) == "!=" {
                    tokens = tokens + [{ kind: "!=", text: "!=", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else if pos + 1 < n and str.substring(src, pos, pos + 2) == "<=" {
                    tokens = tokens + [{ kind: "<=", text: "<=", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else if pos + 1 < n and str.substring(src, pos, pos + 2) == ">=" {
                    tokens = tokens + [{ kind: ">=", text: ">=", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else if pos + 1 < n and str.substring(src, pos, pos + 2) == "+=" {
                    tokens = tokens + [{ kind: "+=", text: "+=", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else if pos + 1 < n and str.substring(src, pos, pos + 2) == "-=" {
                    tokens = tokens + [{ kind: "-=", text: "-=", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else {
                    // Single character symbol
                    let sym = str.substring(src, pos, pos + 1)
                    tokens = tokens + [{ kind: sym, text: sym, line: line, col: start_col, offset: start_pos, length: 1 }]
                    pos = pos + 1
                    col = col + 1
                }
            }
        }
    }

    tokens = tokens + [{ kind: "EOF", text: "", line: line, col: col, offset: pos, length: 0 }]
    tokens
}
