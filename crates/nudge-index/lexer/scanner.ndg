/// Pure-Nudge State-Machine Scanner & Lexer (Optimized Zero-Allocation Slices)
/// Part of Phase 3 (v2.3) - Lexer & Full-Spectrum AST Parser
/// Zero foreign dependencies - 100% Pure Nudge

type Token = {
    kind: string,
    text: string,
    line: int,
    col: int,
    offset: int,
    length: int
}

fn is_digit_code(c: int) -> bool {
    c >= 48 and c <= 57
}

fn is_alpha_code(c: int) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}

fn is_alphanumeric_code(c: int) -> bool {
    is_alpha_code(c) or is_digit_code(c)
}

fn is_kw(s: string) -> bool {
    let len_s = str.length(s)
    if len_s == 2 {
        s == "fn" or s == "in" or s == "if" or s == "or"
    } else if len_s == 3 {
        s == "let" or s == "mut" or s == "for" or s == "and" or s == "not" or s == "par" or s == "map" or s == "mcp" or s == "gen"
    } else if len_s == 4 {
        s == "auth" or s == "else" or s == "tool" or s == "type" or s == "view" or s == "uses" or s == "with" or s == "test" or s == "none" or s == "true" or s == "race" or s == "impl"
    } else if len_s == 5 {
        s == "agent" or s == "state" or s == "costs" or s == "retry" or s == "false" or s == "merge" or s == "route"
    } else if len_s == 6 {
        s == "window" or s == "decide" or s == "repair" or s == "return" or s == "assert" or s == "stream"
    } else if len_s == 7 {
        s == "for_all" or s == "account"
    } else if len_s == 8 {
        s == "provider"
    } else if len_s == 12 {
        s == "side_effects"
    } else {
        false
    }
}

fn scan_tokens(src: string) -> [Token] {
    let n = str.length(src)
    let chars = str.split(src, "")
    let mut tokens: [Token] = []
    let mut pos = 0
    let mut line = 1
    let mut col = 1

    for _ in chars {
        if pos < n {
            let c = str.char_code(src, pos)

            // Whitespace handling
            if c == 32 or c == 9 or c == 13 {
                pos = pos + 1
                col = col + 1
            } else if c == 10 {
                pos = pos + 1
                line = line + 1
                col = 1
            } else if c == 47 and pos + 1 < n and str.char_code(src, pos + 1) == 47 {
                // Single-line comment //
                pos = pos + 2
                col = col + 2
                let mut in_comment = true
                for _ in chars {
                    if pos < n and in_comment {
                        let cc = str.char_code(src, pos)
                        if cc == 10 {
                            in_comment = false
                            pos = pos + 1
                            line = line + 1
                            col = 1
                        } else {
                            pos = pos + 1
                            col = col + 1
                        }
                    }
                }
            } else if c == 47 and pos + 1 < n and str.char_code(src, pos + 1) == 42 {
                // Multi-line comment /* ... */
                pos = pos + 2
                col = col + 2
                let mut in_block = true
                for _ in chars {
                    if pos < n and in_block {
                        let cc = str.char_code(src, pos)
                        if cc == 10 {
                            pos = pos + 1
                            line = line + 1
                            col = 1
                        } else if cc == 42 and pos + 1 < n and str.char_code(src, pos + 1) == 47 {
                            pos = pos + 2
                            col = col + 2
                            in_block = false
                        } else {
                            pos = pos + 1
                            col = col + 1
                        }
                    }
                }
            } else if c == 108 and pos + 5 < n and str.substring(src, pos, pos + 6) == "llm\"\"\"" {
                // Multi-line Prompt Literal: llm"""...""" (Prompt Shielding)
                let start_pos = pos
                let start_col = col
                let start_line = line
                pos = pos + 6
                col = col + 6
                let content_start = pos
                let mut in_prompt = true
                for _ in chars {
                    if pos < n and in_prompt {
                        if pos + 2 < n and str.substring(src, pos, pos + 3) == "\"\"\"" {
                            in_prompt = false
                        } else {
                            let ch_code = str.char_code(src, pos)
                            if ch_code == 10 {
                                line = line + 1
                                col = 1
                            } else {
                                col = col + 1
                            }
                            pos = pos + 1
                        }
                    }
                }
                let prompt_content = str.substring(src, content_start, pos)
                if pos + 2 < n {
                    pos = pos + 3
                    col = col + 3
                }
                tokens = tokens + [{
                    kind: "prompt",
                    text: prompt_content,
                    line: start_line,
                    col: start_col,
                    offset: start_pos,
                    length: pos - start_pos
                }]
            } else if c == 34 {
                // String literal "..."
                let start_pos = pos
                let start_col = col
                let start_line = line
                pos = pos + 1
                col = col + 1
                let content_start = pos
                let mut in_str = true
                let mut has_escapes = false
                for _ in chars {
                    if pos < n and in_str {
                        let sc = str.char_code(src, pos)
                        if sc == 34 {
                            in_str = false
                        } else if sc == 92 and pos + 1 < n {
                            has_escapes = true
                            pos = pos + 2
                            col = col + 2
                        } else {
                            if sc == 10 {
                                line = line + 1
                                col = 1
                            } else {
                                col = col + 1
                            }
                            pos = pos + 1
                        }
                    }
                }
                let content_end = pos
                if pos < n {
                    pos = pos + 1
                    col = col + 1
                }
                let mut content = ""
                if !has_escapes {
                    content = str.substring(src, content_start, content_end)
                } else {
                    let raw = str.substring(src, content_start, content_end)
                    let raw_len = str.length(raw)
                    let mut unescaped = ""
                    let mut i = 0
                    for _ in chars {
                        if i < raw_len {
                            let cc = str.char_code(raw, i)
                            if cc == 92 and i + 1 < raw_len {
                                let next_c = str.char_code(raw, i + 1)
                                if next_c == 110 { unescaped = unescaped + "\n" }
                                else if next_c == 116 { unescaped = unescaped + "\t" }
                                else if next_c == 34 { unescaped = unescaped + "\"" }
                                else if next_c == 92 { unescaped = unescaped + "\\" }
                                else { unescaped = unescaped + str.substring(raw, i + 1, i + 2) }
                                i = i + 2
                            } else {
                                unescaped = unescaped + str.substring(raw, i, i + 1)
                                i = i + 1
                            }
                        }
                    }
                    content = unescaped
                }
                tokens = tokens + [{
                    kind: "string",
                    text: content,
                    line: start_line,
                    col: start_col,
                    offset: start_pos,
                    length: pos - start_pos
                }]
            } else if is_digit_code(c) {
                // Number literal (int or float)
                let start_pos = pos
                let start_col = col
                let mut is_float = false
                let mut reading_num = true
                for _ in chars {
                    if pos < n and reading_num {
                        let nc = str.char_code(src, pos)
                        if is_digit_code(nc) {
                            pos = pos + 1
                            col = col + 1
                        } else if nc == 46 and !is_float and pos + 1 < n and is_digit_code(str.char_code(src, pos + 1)) {
                            is_float = true
                            pos = pos + 1
                            col = col + 1
                        } else {
                            reading_num = false
                        }
                    }
                }
                let num_str = str.substring(src, start_pos, pos)
                let kind = if is_float { "float" } else { "int" }
                tokens = tokens + [{
                    kind: kind,
                    text: num_str,
                    line: line,
                    col: start_col,
                    offset: start_pos,
                    length: pos - start_pos
                }]
            } else if is_alpha_code(c) {
                // Identifier or Keyword
                let start_pos = pos
                let start_col = col
                let mut reading_id = true
                for _ in chars {
                    if pos < n and reading_id {
                        let ic = str.char_code(src, pos)
                        if is_alphanumeric_code(ic) {
                            pos = pos + 1
                            col = col + 1
                        } else {
                            reading_id = false
                        }
                    }
                }
                let ident_str = str.substring(src, start_pos, pos)
                let kind = if is_kw(ident_str) { ident_str } else { "ident" }
                tokens = tokens + [{
                    kind: kind,
                    text: ident_str,
                    line: line,
                    col: start_col,
                    offset: start_pos,
                    length: pos - start_pos
                }]
            } else {
                // Two-character operators
                let start_pos = pos
                let start_col = col
                if pos + 1 < n and str.substring(src, pos, pos + 2) == "->" {
                    tokens = tokens + [{ kind: "->", text: "->", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else if pos + 1 < n and str.substring(src, pos, pos + 2) == "==" {
                    tokens = tokens + [{ kind: "==", text: "==", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else if pos + 1 < n and str.substring(src, pos, pos + 2) == "!=" {
                    tokens = tokens + [{ kind: "!=", text: "!=", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else if pos + 1 < n and str.substring(src, pos, pos + 2) == "<=" {
                    tokens = tokens + [{ kind: "<=", text: "<=", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else if pos + 1 < n and str.substring(src, pos, pos + 2) == ">=" {
                    tokens = tokens + [{ kind: ">=", text: ">=", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else if pos + 1 < n and str.substring(src, pos, pos + 2) == "+=" {
                    tokens = tokens + [{ kind: "+=", text: "+=", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else if pos + 1 < n and str.substring(src, pos, pos + 2) == "-=" {
                    tokens = tokens + [{ kind: "-=", text: "-=", line: line, col: start_col, offset: start_pos, length: 2 }]
                    pos = pos + 2
                    col = col + 2
                } else {
                    // Single character symbol
                    let sym = str.substring(src, pos, pos + 1)
                    tokens = tokens + [{ kind: sym, text: sym, line: line, col: start_col, offset: start_pos, length: 1 }]
                    pos = pos + 1
                    col = col + 1
                }
            }
        }
    }

    tokens = tokens + [{ kind: "EOF", text: "", line: line, col: col, offset: pos, length: 0 }]
    tokens
}

fn main() -> int {
    let toks = scan_tokens("fn hello() { \"test\" }")
    if len(toks) > 0 { 0 } else { 1 }
}

test "scanner tokens, prompts and string slices" {
    let code = "fn run() uses LLM { llm\"\"\"SELECT * FROM users WHERE status = 'active';\"\"\" let msg = \"hello \\n world\" }"
    let toks = scan_tokens(code)
    assert len(toks) > 8

    let mut found_prompt = false
    let mut found_str = false
    for t in toks {
        if t.kind == "prompt" {
            found_prompt = true
            assert str.contains(t.text, "SELECT * FROM users")
        }
        if t.kind == "string" {
            found_str = true
            assert str.contains(t.text, "hello \n world")
        }
    }
    assert found_prompt
    assert found_str
}
