/// NVFS Inode Registry & Virtual File Descriptors with Native Map Path Resolution
/// Part of Phase 2 (v2.2) - In-Memory Indexing & Virtual File System
/// Zero foreign dependencies - 100% Pure Nudge

type Inode = {
    id: int,
    path: string,
    name: string,
    parent_id: int,
    is_dir: bool,
    size: int,
    mtime: int,
    block_hashes: [string],
    permissions: int
}

type FileHandle = {
    fd: int,
    inode_id: int,
    path: string,
    offset: int,
    mode: string,
    is_open: bool
}

type InodeStat = {
    exists: bool,
    id: int,
    is_dir: bool,
    size: int,
    mtime: int
}

fn normalize_path(raw_path: string) -> string {
    let raw_parts = str.split(raw_path, "/")
    let mut stack: [string] = []
    for p in raw_parts {
        if p == "" or p == "." {
            // skip redundant segments
        } else if p == ".." {
            let stack_len = len(stack)
            if stack_len > 0 {
                let mut new_stack: [string] = []
                for (item, idx) in stack {
                    if idx < stack_len - 1 {
                        new_stack = new_stack + [item]
                    }
                }
                stack = new_stack
            }
        } else {
            stack = stack + [p]
        }
    }
    let total = len(stack)
    let mut res = ""
    if total == 0 {
        res = "/"
    } else {
        for s in stack {
            res = res + "/" + s
        }
    }
    res
}

fn get_basename(path: string) -> string {
    let parts = str.split(path, "/")
    let mut last = ""
    for p in parts {
        if p != "" {
            last = p
        }
    }
    if last == "" { "/" } else { last }
}

fn get_parent_dir(path: string) -> string {
    let norm = normalize_path(path)
    let parts = str.split(norm, "/")
    let mut valid_parts: [string] = []
    for p in parts {
        if p != "" {
            valid_parts = valid_parts + [p]
        }
    }
    let total = len(valid_parts)
    let mut parent = ""
    if total <= 1 {
        parent = "/"
    } else {
        for (p, idx) in valid_parts {
            if idx < total - 1 {
                parent = parent + "/" + p
            }
        }
    }
    parent
}

fn contains_path(xs: [string], target: string) -> bool {
    let mut found = false
    for x in xs {
        if x == target {
            found = true
        }
    }
    found
}

agent InodeTable {
    state {
        next_id: int = 1
        next_fd: int = 100
        inodes: [Inode] = [
            { id: 0, path: "/", name: "/", parent_id: -1, is_dir: true, size: 0, mtime: 0, block_hashes: [], permissions: 755 }
        ]
        open_handles: [FileHandle] = []
        path_to_id: Map[string, int] = {}
        all_paths: [string] = []
    }

    fn reset() {
        state.next_id = 1
        state.next_fd = 100
        state.inodes = [
            { id: 0, path: "/", name: "/", parent_id: -1, is_dir: true, size: 0, mtime: 0, block_hashes: [], permissions: 755 }
        ]
        state.open_handles = []
        state.path_to_id = {}
        state.all_paths = []
    }

    fn count() -> int {
        len(state.inodes)
    }

    fn find_by_path(target_path: string) -> int {
        let norm = normalize_path(target_path)
        if norm == "/" {
            0
        } else if contains_path(state.all_paths, norm) {
            state.path_to_id[norm]
        } else {
            -1
        }
    }

    fn stat(target_path: string) -> InodeStat {
        let norm = normalize_path(target_path)
        let mut res: InodeStat = { exists: false, id: -1, is_dir: false, size: 0, mtime: 0 }
        let nid = InodeTable.find_by_path(norm)
        if nid != -1 {
            for node in state.inodes {
                if node.id == nid {
                    res = {
                        exists: true,
                        id: node.id,
                        is_dir: node.is_dir,
                        size: node.size,
                        mtime: node.mtime
                    }
                }
            }
        }
        res
    }

    fn mkdir(dir_path: string, mtime: int) -> int {
        let norm = normalize_path(dir_path)
        let existing = InodeTable.find_by_path(norm)
        let mut ret_id = existing
        if existing == -1 {
            let parent_path = get_parent_dir(norm)
            let parent_id = InodeTable.find_by_path(parent_path)
            let resolved_parent = if parent_id == -1 {
                InodeTable.mkdir(parent_path, mtime)
            } else {
                parent_id
            }
            let id = state.next_id
            state.next_id += 1
            let name = get_basename(norm)
            let new_node: Inode = {
                id: id,
                path: norm,
                name: name,
                parent_id: resolved_parent,
                is_dir: true,
                size: 0,
                mtime: mtime,
                block_hashes: [],
                permissions: 755
            }
            state.inodes = state.inodes + [new_node]
            state.path_to_id[norm] = id
            state.all_paths = state.all_paths + [norm]
            ret_id = id
        }
        ret_id
    }

    fn create_file(file_path: string, block_hashes: [string], size: int, mtime: int) -> int {
        let norm = normalize_path(file_path)
        let existing = InodeTable.find_by_path(norm)
        let mut ret_id = existing
        if existing != -1 {
            let mut updated: [Inode] = []
            for node in state.inodes {
                if node.id == existing {
                    let mod_node: Inode = {
                        id: node.id,
                        path: node.path,
                        name: node.name,
                        parent_id: node.parent_id,
                        is_dir: node.is_dir,
                        size: size,
                        mtime: mtime,
                        block_hashes: block_hashes,
                        permissions: node.permissions
                    }
                    updated = updated + [mod_node]
                } else {
                    updated = updated + [node]
                }
            }
            state.inodes = updated
            ret_id = existing
        } else {
            let parent_path = get_parent_dir(norm)
            let parent_id = InodeTable.mkdir(parent_path, mtime)
            let id = state.next_id
            state.next_id += 1
            let name = get_basename(norm)
            let new_node: Inode = {
                id: id,
                path: norm,
                name: name,
                parent_id: parent_id,
                is_dir: false,
                size: size,
                mtime: mtime,
                block_hashes: block_hashes,
                permissions: 644
            }
            state.inodes = state.inodes + [new_node]
            state.path_to_id[norm] = id
            state.all_paths = state.all_paths + [norm]
            ret_id = id
        }
        ret_id
    }

    fn get_blocks(inode_id: int) -> [string] {
        let mut hashes: [string] = []
        for node in state.inodes {
            if node.id == inode_id {
                hashes = node.block_hashes
            }
        }
        hashes
    }

    fn delete_inode(target_path: string) -> bool {
        let norm = normalize_path(target_path)
        let existing = InodeTable.find_by_path(norm)
        let mut deleted = false
        if existing != -1 and existing != 0 {
            let mut remaining: [Inode] = []
            for node in state.inodes {
                if node.id != existing {
                    remaining = remaining + [node]
                }
            }
            state.inodes = remaining

            let mut remaining_paths: [string] = []
            let mut new_path_map: Map[string, int] = {}
            for p in state.all_paths {
                if p != norm {
                    remaining_paths = remaining_paths + [p]
                    new_path_map[p] = state.path_to_id[p]
                }
            }
            state.all_paths = remaining_paths
            state.path_to_id = new_path_map
            deleted = true
        }
        deleted
    }

    fn list_dir(dir_path: string) -> [string] {
        let norm = normalize_path(dir_path)
        let parent_id = InodeTable.find_by_path(norm)
        let mut entries: [string] = []
        if parent_id != -1 {
            for node in state.inodes {
                if node.parent_id == parent_id {
                    entries = entries + [node.name]
                }
            }
        }
        entries
    }

    fn open_handle(file_path: string, mode: string) -> int {
        let norm = normalize_path(file_path)
        let mut target_id = InodeTable.find_by_path(norm)
        if target_id == -1 and (mode == "w" or mode == "a") {
            target_id = InodeTable.create_file(norm, [], 0, 1)
        }
        let mut ret_fd = -1
        if target_id != -1 {
            let fd = state.next_fd
            state.next_fd += 1
            let handle: FileHandle = {
                fd: fd,
                inode_id: target_id,
                path: norm,
                offset: 0,
                mode: mode,
                is_open: true
            }
            state.open_handles = state.open_handles + [handle]
            ret_fd = fd
        }
        ret_fd
    }

    fn close_handle(fd: int) -> bool {
        let mut updated: [FileHandle] = []
        let mut found = false
        for h in state.open_handles {
            if h.fd == fd {
                let closed: FileHandle = {
                    fd: h.fd,
                    inode_id: h.inode_id,
                    path: h.path,
                    offset: h.offset,
                    mode: h.mode,
                    is_open: false
                }
                updated = updated + [closed]
                found = true
            } else {
                updated = updated + [h]
            }
        }
        state.open_handles = updated
        found
    }

    fn seek(fd: int, new_offset: int) -> bool {
        let mut updated: [FileHandle] = []
        let mut found = false
        for h in state.open_handles {
            if h.fd == fd and h.is_open {
                let moved: FileHandle = {
                    fd: h.fd,
                    inode_id: h.inode_id,
                    path: h.path,
                    offset: new_offset,
                    mode: h.mode,
                    is_open: true
                }
                updated = updated + [moved]
                found = true
            } else {
                updated = updated + [h]
            }
        }
        state.open_handles = updated
        found
    }

    fn tell(fd: int) -> int {
        let mut pos = -1
        for h in state.open_handles {
            if h.fd == fd and h.is_open {
                pos = h.offset
            }
        }
        pos
    }
}

fn main() -> int {
    InodeTable.reset()
    let d_id = InodeTable.mkdir("/src/core", 100)
    let f_id = InodeTable.create_file("/src/core/main.ndg", ["blk_001", "blk_002"], 42, 101)
    let st = InodeTable.stat("/src/core/main.ndg")
    let children = InodeTable.list_dir("/src/core")
    let fd = InodeTable.open_handle("/src/core/main.ndg", "r")
    let _s = InodeTable.seek(fd, 10)
    let pos = InodeTable.tell(fd)
    let _c = InodeTable.close_handle(fd)
    if st.exists and st.id == f_id and len(children) == 1 and pos == 10 {
        0
    } else {
        1
    }
}

test "inode path normalization and resolution" {
    let p1 = normalize_path("/a/b/../c/./d")
    assert p1 == "/a/c/d"

    let p2 = normalize_path("///var//log///")
    assert p2 == "/var/log"

    let p3 = normalize_path("/a/b/c/../../..")
    assert p3 == "/"

    let p4 = normalize_path(".")
    assert p4 == "/"
}

test "inode table lifecycle and tree manipulation" {
    InodeTable.reset()
    assert InodeTable.count() == 1

    let dir_id = InodeTable.mkdir("/workspace/src", 1000)
    assert dir_id > 0
    assert InodeTable.find_by_path("/workspace/src") == dir_id

    let file_id = InodeTable.create_file("/workspace/src/app.ndg", ["hash_1", "hash_2"], 1024, 1005)
    assert file_id > dir_id

    let st = InodeTable.stat("/workspace/src/app.ndg")
    assert st.exists
    assert !st.is_dir
    assert st.size == 1024

    let children = InodeTable.list_dir("/workspace/src")
    assert len(children) == 1
    assert children[0] == "app.ndg"

    let blks = InodeTable.get_blocks(file_id)
    assert len(blks) == 2
    assert blks[0] == "hash_1"

    assert InodeTable.delete_inode("/workspace/src/app.ndg")
    assert InodeTable.find_by_path("/workspace/src/app.ndg") == -1
    assert len(InodeTable.list_dir("/workspace/src")) == 0
}

test "file descriptor handles seek and tell" {
    InodeTable.reset()
    let fd = InodeTable.open_handle("/test.txt", "w")
    assert fd >= 100
    assert InodeTable.tell(fd) == 0

    assert InodeTable.seek(fd, 50)
    assert InodeTable.tell(fd) == 50

    assert InodeTable.close_handle(fd)
    assert InodeTable.tell(fd) == -1
}
