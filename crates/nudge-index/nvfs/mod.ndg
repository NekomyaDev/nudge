/// NVFS Master Unified In-Memory Virtual File System
/// Part of Phase 2 (v2.2) - In-Memory Indexing & Virtual File System
/// Zero foreign dependencies - 100% Pure Nudge

type Inode = {
    id: int,
    path: string,
    name: string,
    parent_id: int,
    is_dir: bool,
    size: int,
    mtime: int,
    block_hashes: [string],
    permissions: int
}

type FileHandle = {
    fd: int,
    inode_id: int,
    path: string,
    offset: int,
    mode: string,
    is_open: bool
}

type InodeStat = {
    exists: bool,
    id: int,
    is_dir: bool,
    size: int,
    mtime: int
}

type CasBlock = {
    hash: string,
    content: string,
    size: int,
    ref_count: int
}

type TxRecord = {
    tx_id: int,
    op_type: string,
    path: string,
    old_hashes: [string],
    new_hashes: [string],
    status: string
}

type VfsSummary = {
    total_inodes: int,
    total_files: int,
    total_dirs: int,
    cas_blocks: int,
    dedup_saved_bytes: int,
    transactions: int
}

fn normalize_path(raw_path: string) -> string {
    let raw_parts = str.split(raw_path, "/")
    let mut stack: [string] = []
    for p in raw_parts {
        if p == "" or p == "." {
            // skip
        } else if p == ".." {
            let stack_len = len(stack)
            if stack_len > 0 {
                let mut new_stack: [string] = []
                for (item, idx) in stack {
                    if idx < stack_len - 1 {
                        new_stack = new_stack + [item]
                    }
                }
                stack = new_stack
            }
        } else {
            stack = stack + [p]
        }
    }
    let total = len(stack)
    let mut res = ""
    if total == 0 {
        res = "/"
    } else {
        for s in stack {
            res = res + "/" + s
        }
    }
    res
}

fn get_basename(path: string) -> string {
    let parts = str.split(path, "/")
    let mut last = ""
    for p in parts {
        if p != "" {
            last = p
        }
    }
    if last == "" { "/" } else { last }
}

fn get_parent_dir(path: string) -> string {
    let norm = normalize_path(path)
    let parts = str.split(norm, "/")
    let mut valid_parts: [string] = []
    for p in parts {
        if p != "" {
            valid_parts = valid_parts + [p]
        }
    }
    let total = len(valid_parts)
    let mut parent = ""
    if total <= 1 {
        parent = "/"
    } else {
        for (p, idx) in valid_parts {
            if idx < total - 1 {
                parent = parent + "/" + p
            }
        }
    }
    parent
}

fn contains_nvfs_str(xs: [string], target: string) -> bool {
    let mut found = false
    for x in xs {
        if x == target {
            found = true
        }
    }
    found
}

fn compute_block_hash(content: string) -> string {
    let raw_h = str.hash(content)
    let pos_h = if raw_h < 0 { -raw_h } else { raw_h }
    "blk_" + str.to_string(pos_h)
}

fn split_lines_into_chunks(content: string, lines_per_chunk: int) -> [string] {
    let lines = str.split(content, "\n")
    let total_lines = len(lines)
    let mut chunks: [string] = []
    let mut cur_chunk = ""
    let mut in_chunk_count = 0

    for (line, idx) in lines {
        if in_chunk_count == 0 {
            cur_chunk = line
        } else {
            cur_chunk = cur_chunk + "\n" + line
        }
        in_chunk_count = in_chunk_count + 1

        if in_chunk_count >= lines_per_chunk or idx == total_lines - 1 {
            chunks = chunks + [cur_chunk]
            cur_chunk = ""
            in_chunk_count = 0
        }
    }
    chunks
}

agent InodeTable {
    state {
        next_id: int = 1
        next_fd: int = 100
        inodes: [Inode] = [
            { id: 0, path: "/", name: "/", parent_id: -1, is_dir: true, size: 0, mtime: 0, block_hashes: [], permissions: 755 }
        ]
        open_handles: [FileHandle] = []
        path_to_id: Map[string, int] = {}
        all_paths: [string] = []
    }

    fn reset_inodes() {
        state.next_id = 1
        state.next_fd = 100
        state.inodes = [
            { id: 0, path: "/", name: "/", parent_id: -1, is_dir: true, size: 0, mtime: 0, block_hashes: [], permissions: 755 }
        ]
        state.open_handles = []
        state.path_to_id = {}
        state.all_paths = []
    }

    fn find_by_path(target_path: string) -> int {
        let norm = normalize_path(target_path)
        if norm == "/" {
            0
        } else if contains_nvfs_str(state.all_paths, norm) {
            state.path_to_id[norm]
        } else {
            -1
        }
    }

    fn stat(target_path: string) -> InodeStat {
        let norm = normalize_path(target_path)
        let mut res: InodeStat = { exists: false, id: -1, is_dir: false, size: 0, mtime: 0 }
        let nid = InodeTable.find_by_path(norm)
        if nid != -1 {
            for node in state.inodes {
                if node.id == nid {
                    res = {
                        exists: true,
                        id: node.id,
                        is_dir: node.is_dir,
                        size: node.size,
                        mtime: node.mtime
                    }
                }
            }
        }
        res
    }

    fn mkdir(dir_path: string, mtime: int) -> int {
        let norm = normalize_path(dir_path)
        let existing = InodeTable.find_by_path(norm)
        let mut ret_id = existing
        if existing == -1 {
            let parent_path = get_parent_dir(norm)
            let parent_id = InodeTable.find_by_path(parent_path)
            let resolved_parent = if parent_id == -1 {
                InodeTable.mkdir(parent_path, mtime)
            } else {
                parent_id
            }
            let id = state.next_id
            state.next_id += 1
            let name = get_basename(norm)
            let new_node: Inode = {
                id: id,
                path: norm,
                name: name,
                parent_id: resolved_parent,
                is_dir: true,
                size: 0,
                mtime: mtime,
                block_hashes: [],
                permissions: 755
            }
            state.inodes = state.inodes + [new_node]
            state.path_to_id[norm] = id
            state.all_paths = state.all_paths + [norm]
            ret_id = id
        }
        ret_id
    }

    fn create_file(file_path: string, block_hashes: [string], size: int, mtime: int) -> int {
        let norm = normalize_path(file_path)
        let existing = InodeTable.find_by_path(norm)
        let mut ret_id = existing
        if existing != -1 {
            let mut updated: [Inode] = []
            for node in state.inodes {
                if node.id == existing {
                    let mod_node: Inode = {
                        id: node.id,
                        path: node.path,
                        name: node.name,
                        parent_id: node.parent_id,
                        is_dir: node.is_dir,
                        size: size,
                        mtime: mtime,
                        block_hashes: block_hashes,
                        permissions: node.permissions
                    }
                    updated = updated + [mod_node]
                } else {
                    updated = updated + [node]
                }
            }
            state.inodes = updated
            ret_id = existing
        } else {
            let parent_path = get_parent_dir(norm)
            let parent_id = InodeTable.mkdir(parent_path, mtime)
            let id = state.next_id
            state.next_id += 1
            let name = get_basename(norm)
            let new_node: Inode = {
                id: id,
                path: norm,
                name: name,
                parent_id: parent_id,
                is_dir: false,
                size: size,
                mtime: mtime,
                block_hashes: block_hashes,
                permissions: 644
            }
            state.inodes = state.inodes + [new_node]
            state.path_to_id[norm] = id
            state.all_paths = state.all_paths + [norm]
            ret_id = id
        }
        ret_id
    }

    fn get_blocks(inode_id: int) -> [string] {
        let mut hashes: [string] = []
        for node in state.inodes {
            if node.id == inode_id {
                hashes = node.block_hashes
            }
        }
        hashes
    }

    fn delete_inode(target_path: string) -> bool {
        let norm = normalize_path(target_path)
        let existing = InodeTable.find_by_path(norm)
        let mut deleted = false
        if existing != -1 and existing != 0 {
            let mut remaining: [Inode] = []
            for node in state.inodes {
                if node.id != existing {
                    remaining = remaining + [node]
                }
            }
            state.inodes = remaining

            let mut remaining_paths: [string] = []
            let mut new_path_map: Map[string, int] = {}
            for p in state.all_paths {
                if p != norm {
                    remaining_paths = remaining_paths + [p]
                    new_path_map[p] = state.path_to_id[p]
                }
            }
            state.all_paths = remaining_paths
            state.path_to_id = new_path_map
            deleted = true
        }
        deleted
    }

    fn list_dir(dir_path: string) -> [string] {
        let norm = normalize_path(dir_path)
        let parent_id = InodeTable.find_by_path(norm)
        let mut entries: [string] = []
        if parent_id != -1 {
            for node in state.inodes {
                if node.parent_id == parent_id {
                    entries = entries + [node.name]
                }
            }
        }
        entries
    }
}

agent CasStore {
    state {
        blocks: [CasBlock] = []
        block_map: Map[string, CasBlock] = {}
        block_hashes: [string] = []
        total_allocations: int = 0
        dedup_count: int = 0
        dedup_saved_bytes: int = 0
    }

    fn reset_cas() {
        state.blocks = []
        state.block_map = {}
        state.block_hashes = []
        state.total_allocations = 0
        state.dedup_count = 0
        state.dedup_saved_bytes = 0
    }

    fn put_chunk(chunk: string) -> string {
        let h = compute_block_hash(chunk)
        let chunk_size = str.length(chunk)

        if contains_nvfs_str(state.block_hashes, h) {
            let b = state.block_map[h]
            let inc_b: CasBlock = {
                hash: b.hash,
                content: b.content,
                size: b.size,
                ref_count: b.ref_count + 1
            }
            state.block_map[h] = inc_b
            let mut updated_blocks: [CasBlock] = []
            for blk in state.blocks {
                if blk.hash == h {
                    updated_blocks = updated_blocks + [inc_b]
                } else {
                    updated_blocks = updated_blocks + [blk]
                }
            }
            state.blocks = updated_blocks
            state.dedup_count += 1
            state.dedup_saved_bytes += chunk_size
        } else {
            let new_b: CasBlock = {
                hash: h,
                content: chunk,
                size: chunk_size,
                ref_count: 1
            }
            state.block_map[h] = new_b
            state.block_hashes = state.block_hashes + [h]
            state.blocks = state.blocks + [new_b]
            state.total_allocations += 1
        }
        h
    }

    fn get_chunk(h: string) -> string {
        let mut res = ""
        if contains_nvfs_str(state.block_hashes, h) {
            res = state.block_map[h].content
        }
        res
    }

    fn put_content(content: string, lines_per_chunk: int) -> [string] {
        let chunks = split_lines_into_chunks(content, lines_per_chunk)
        let mut hashes: [string] = []
        for chunk in chunks {
            let h = CasStore.put_chunk(chunk)
            hashes = hashes + [h]
        }
        hashes
    }

    fn get_content(hashes: [string]) -> string {
        let mut full = ""
        for (h, idx) in hashes {
            let chunk = CasStore.get_chunk(h)
            if idx == 0 {
                full = chunk
            } else {
                full = full + "\n" + chunk
            }
        }
        full
    }
}

agent Journal {
    state {
        next_tx_id: int = 1
        transactions: [TxRecord] = []
        committed_count: int = 0
        rolled_back_count: int = 0
    }

    fn reset_journal() {
        state.next_tx_id = 1
        state.transactions = []
        state.committed_count = 0
        state.rolled_back_count = 0
    }

    fn begin_tx(op_type: string, path: string, old_hashes: [string]) -> int {
        let id = state.next_tx_id
        state.next_tx_id += 1
        let tx: TxRecord = {
            tx_id: id,
            op_type: op_type,
            path: path,
            old_hashes: old_hashes,
            new_hashes: [],
            status: "ACTIVE"
        }
        state.transactions = state.transactions + [tx]
        id
    }

    fn record_new_hashes(tx_id: int, new_hashes: [string]) -> bool {
        let mut updated: [TxRecord] = []
        let mut found = false
        for tx in state.transactions {
            if tx.tx_id == tx_id {
                let mod_tx: TxRecord = {
                    tx_id: tx.tx_id,
                    op_type: tx.op_type,
                    path: tx.path,
                    old_hashes: tx.old_hashes,
                    new_hashes: new_hashes,
                    status: tx.status
                }
                updated = updated + [mod_tx]
                found = true
            } else {
                updated = updated + [tx]
            }
        }
        state.transactions = updated
        found
    }

    fn commit_tx(tx_id: int) -> bool {
        let mut updated: [TxRecord] = []
        let mut found = false
        for tx in state.transactions {
            if tx.tx_id == tx_id and tx.status == "ACTIVE" {
                let committed: TxRecord = {
                    tx_id: tx.tx_id,
                    op_type: tx.op_type,
                    path: tx.path,
                    old_hashes: tx.old_hashes,
                    new_hashes: tx.new_hashes,
                    status: "COMMITTED"
                }
                updated = updated + [committed]
                found = true
            } else {
                updated = updated + [tx]
            }
        }
        if found {
            state.transactions = updated
            state.committed_count += 1
        }
        found
    }

    fn rollback_tx(tx_id: int) -> [string] {
        let mut updated: [TxRecord] = []
        let mut restored_hashes: [string] = []
        for tx in state.transactions {
            if tx.tx_id == tx_id and (tx.status == "ACTIVE" or tx.status == "COMMITTED") {
                let rolled: TxRecord = {
                    tx_id: tx.tx_id,
                    op_type: tx.op_type,
                    path: tx.path,
                    old_hashes: tx.old_hashes,
                    new_hashes: tx.new_hashes,
                    status: "ROLLED_BACK"
                }
                updated = updated + [rolled]
                restored_hashes = tx.old_hashes
            } else {
                updated = updated + [tx]
            }
        }
        if len(restored_hashes) > 0 or len(updated) > 0 {
            state.transactions = updated
            state.rolled_back_count += 1
        }
        restored_hashes
    }
}

// ── High-Level Virtual File System API ───────────────────────────────

fn vfs_init() {
    InodeTable.reset_inodes()
    CasStore.reset_cas()
    Journal.reset_journal()
}

fn vfs_write(path: string, content: string, mtime: int) -> int {
    let norm = normalize_path(path)
    let existing_id = InodeTable.find_by_path(norm)
    let old_hashes = if existing_id != -1 {
        InodeTable.get_blocks(existing_id)
    } else {
        []
    }

    let tx_id = Journal.begin_tx("WRITE", norm, old_hashes)
    let new_hashes = CasStore.put_content(content, 1)
    let _r = Journal.record_new_hashes(tx_id, new_hashes)

    let _inode_id = InodeTable.create_file(norm, new_hashes, str.length(content), mtime)
    let _c = Journal.commit_tx(tx_id)
    tx_id
}

fn vfs_read(path: string) -> string {
    let norm = normalize_path(path)
    let inode_id = InodeTable.find_by_path(norm)
    let mut content = ""
    if inode_id != -1 {
        let hashes = InodeTable.get_blocks(inode_id)
        content = CasStore.get_content(hashes)
    }
    content
}

fn vfs_exists(path: string) -> bool {
    let st = InodeTable.stat(path)
    st.exists
}

fn vfs_delete(path: string) -> bool {
    let norm = normalize_path(path)
    let existing_id = InodeTable.find_by_path(norm)
    let mut ok = false
    if existing_id != -1 {
        let old_hashes = InodeTable.get_blocks(existing_id)
        let tx_id = Journal.begin_tx("DELETE", norm, old_hashes)
        ok = InodeTable.delete_inode(norm)
        let _c = Journal.commit_tx(tx_id)
    }
    ok
}

fn vfs_list(dir_path: string) -> [string] {
    InodeTable.list_dir(dir_path)
}

fn vfs_mkdir(dir_path: string, mtime: int) -> int {
    InodeTable.mkdir(dir_path, mtime)
}

fn vfs_summary() -> VfsSummary {
    let mut files = 0
    let mut dirs = 0
    for node in InodeTable.state.inodes {
        if node.is_dir {
            dirs = dirs + 1
        } else {
            files = files + 1
        }
    }
    {
        total_inodes: len(InodeTable.state.inodes),
        total_files: files,
        total_dirs: dirs,
        cas_blocks: len(CasStore.state.blocks),
        dedup_saved_bytes: CasStore.state.dedup_saved_bytes,
        transactions: len(Journal.state.transactions)
    }
}

fn main() -> int {
    vfs_init()
    let _tx1 = vfs_write("/pkg/math.ndg", "fn add(a: int, b: int) -> int { a + b }", 1)
    let _tx2 = vfs_write("/pkg/sub.ndg", "fn sub(a: int, b: int) -> int { a - b }", 2)
    let c1 = vfs_read("/pkg/math.ndg")
    let sum = vfs_summary()
    if str.length(c1) > 0 and sum.total_files == 2 and sum.total_dirs >= 1 {
        0
    } else {
        1
    }
}

test "nvfs full lifecycle in-memory write and read" {
    vfs_init()
    let code = "fn compute() -> int {\n    let mut x = 1\n    x + 41\n}"
    let tx = vfs_write("/src/compute.ndg", code, 100)
    assert tx > 0
    assert vfs_exists("/src/compute.ndg")

    let read_back = vfs_read("/src/compute.ndg")
    assert read_back == code

    let children = vfs_list("/src")
    assert len(children) == 1
    assert children[0] == "compute.ndg"

    assert vfs_delete("/src/compute.ndg")
    assert !vfs_exists("/src/compute.ndg")
}

test "nvfs cross-file deduplication" {
    vfs_init()
    let boilerplate = "/// Shared Header Comment\ntype Context = { req_id: string }"
    let f1 = boilerplate + "\nfn handler_a() { 1 }"
    let f2 = boilerplate + "\nfn handler_b() { 2 }"

    let _t1 = vfs_write("/handlers/a.ndg", f1, 10)
    let _t2 = vfs_write("/handlers/b.ndg", f2, 11)

    let sum = vfs_summary()
    assert sum.total_files == 2
    assert sum.dedup_saved_bytes > 0
}
