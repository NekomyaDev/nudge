/// Pure-Nudge In-Memory Inverted Index & Posting Lists
/// Part of Phase 5 (v2.5) - Query Engine & Benchmarking
/// Zero foreign dependencies - 100% Pure Nudge

type PostingMatch = {
    file_path: string,
    symbol: string,
    line: int,
    snippet: string
}

type PostingEntry = {
    term: string,
    matches: [PostingMatch]
}

agent InvertedIndex {
    state {
        postings: [PostingEntry] = []
        term_count: int = 0
    }

    fn reset_inverted_index() {
        state.postings = []
        state.term_count = 0
    }

    fn index_term(term: string, file_path: string, symbol: string, line: int, snippet: string) {
        let clean_term = str.trim(str.lower(term))
        if clean_term != "" {
            let m: PostingMatch = {
                file_path: file_path,
                symbol: symbol,
                line: line,
                snippet: snippet
            }
            let mut updated: [PostingEntry] = []
            let mut found = false
            for p in state.postings {
                if p.term == clean_term {
                    updated = updated + [{
                        term: p.term,
                        matches: p.matches + [m]
                    }]
                    found = true
                } else {
                    updated = updated + [p]
                }
            }
            if !found {
                updated = updated + [{
                    term: clean_term,
                    matches: [m]
                }]
                state.term_count = state.term_count + 1
            }
            state.postings = updated
        }
    }

    fn search(query: string) -> [PostingMatch] {
        let q = str.trim(str.lower(query))
        let mut results: [PostingMatch] = []
        for p in state.postings {
            if p.term == q or str.contains(p.term, q) {
                results = results + p.matches
            }
        }
        results
    }
}

fn main() -> int {
    InvertedIndex.reset_inverted_index()
    InvertedIndex.index_term("calculate", "/src/calc.ndg", "calc_tax", 10, "fn calc_tax()")
    let results = InvertedIndex.search("calculate")
    if len(results) == 1 and results[0].symbol == "calc_tax" {
        0
    } else {
        1
    }
}

test "inverted index case-insensitive and substring search" {
    InvertedIndex.reset_inverted_index()
    InvertedIndex.index_term("AuthToken", "/auth.ndg", "validate_token", 5, "fn validate_token()")
    InvertedIndex.index_term("RefreshToken", "/auth.ndg", "refresh_session", 25, "fn refresh_session()")
    InvertedIndex.index_term("PaymentGateway", "/pay.ndg", "charge_card", 100, "fn charge_card()")

    // Case-insensitive exact match
    let r1 = InvertedIndex.search("authtoken")
    assert len(r1) == 1
    assert r1[0].symbol == "validate_token"

    // Substring search matching both token entries
    let r2 = InvertedIndex.search("token")
    assert len(r2) == 2
    assert r2[0].symbol == "validate_token"
    assert r2[1].symbol == "refresh_session"

    // No match
    let r3 = InvertedIndex.search("nonexistent")
    assert len(r3) == 0
}
