/// Pure-Nudge High-Performance In-Memory Symbol Table with Native Map Lookups
/// Part of Phase 5 (v2.5) - Query Engine & Benchmarking
/// Zero foreign dependencies - 100% Pure Nudge

type SymbolEntry = {
    name: string,
    kind: string,
    file_path: string,
    line: int,
    signature: string,
    effects: [string]
}

fn list_has_string(xs: [string], target: string) -> bool {
    let mut found = false
    for x in xs {
        if x == target {
            found = true
        }
    }
    found
}

agent SymbolTable {
    state {
        symbols: Map[string, SymbolEntry] = {}
        symbol_names: [string] = []
        all_symbols: [SymbolEntry] = []
        total_count: int = 0
        file_symbols: Map[string, [SymbolEntry]] = {}
        all_files: [string] = []
        kind_symbols: Map[string, [SymbolEntry]] = {}
        all_kinds: [string] = []
        effect_symbols: Map[string, [SymbolEntry]] = {}
        all_effects: [string] = []
    }

    fn reset_symbol_table() {
        state.symbols = {}
        state.symbol_names = []
        state.all_symbols = []
        state.total_count = 0
        state.file_symbols = {}
        state.all_files = []
        state.kind_symbols = {}
        state.all_kinds = []
        state.effect_symbols = {}
        state.all_effects = []
    }

    fn count() -> int {
        state.total_count
    }

    fn insert(entry: SymbolEntry) {
        state.symbols[entry.name] = entry
        let mut updated: [SymbolEntry] = []
        let mut replaced = false
        for e in state.all_symbols {
            if e.name == entry.name {
                updated = updated + [entry]
                replaced = true
            } else {
                updated = updated + [e]
            }
        }
        if !replaced {
            updated = updated + [entry]
            state.symbol_names = state.symbol_names + [entry.name]
            state.total_count = state.total_count + 1
        }
        state.all_symbols = updated

        // Index by file
        if list_has_string(state.all_files, entry.file_path) {
            let mut file_updated: [SymbolEntry] = []
            let mut file_replaced = false
            for fe in state.file_symbols[entry.file_path] {
                if fe.name == entry.name {
                    file_updated = file_updated + [entry]
                    file_replaced = true
                } else {
                    file_updated = file_updated + [fe]
                }
            }
            if !file_replaced {
                file_updated = file_updated + [entry]
            }
            state.file_symbols[entry.file_path] = file_updated
        } else {
            state.file_symbols[entry.file_path] = [entry]
            state.all_files = state.all_files + [entry.file_path]
        }

        // Index by kind
        if list_has_string(state.all_kinds, entry.kind) {
            let mut kind_updated: [SymbolEntry] = []
            let mut kind_replaced = false
            for ke in state.kind_symbols[entry.kind] {
                if ke.name == entry.name {
                    kind_updated = kind_updated + [entry]
                    kind_replaced = true
                } else {
                    kind_updated = kind_updated + [ke]
                }
            }
            if !kind_replaced {
                kind_updated = kind_updated + [entry]
            }
            state.kind_symbols[entry.kind] = kind_updated
        } else {
            state.kind_symbols[entry.kind] = [entry]
            state.all_kinds = state.all_kinds + [entry.kind]
        }

        // Index by effect
        for eff in entry.effects {
            if list_has_string(state.all_effects, eff) {
                let mut eff_updated: [SymbolEntry] = []
                let mut eff_replaced = false
                for ee in state.effect_symbols[eff] {
                    if ee.name == entry.name {
                        eff_updated = eff_updated + [entry]
                        eff_replaced = true
                    } else {
                        eff_updated = eff_updated + [ee]
                    }
                }
                if !eff_replaced {
                    eff_updated = eff_updated + [entry]
                }
                state.effect_symbols[eff] = eff_updated
            } else {
                state.effect_symbols[eff] = [entry]
                state.all_effects = state.all_effects + [eff]
            }
        }
    }

    fn lookup(name: string) -> SymbolEntry? {
        let mut found: SymbolEntry? = none
        if list_has_string(state.symbol_names, name) {
            found = state.symbols[name]
        }
        found
    }

    fn remove(name: string) -> bool {
        let mut did_remove = false
        if list_has_string(state.symbol_names, name) {
            let mut updated_syms: [SymbolEntry] = []
            let mut updated_names: [string] = []
            let mut new_map: Map[string, SymbolEntry] = {}
            let mut new_file_map: Map[string, [SymbolEntry]] = {}
            let mut new_all_files: [string] = []
            let mut new_kind_map: Map[string, [SymbolEntry]] = {}
            let mut new_all_kinds: [string] = []
            let mut new_eff_map: Map[string, [SymbolEntry]] = {}
            let mut new_all_effs: [string] = []
            for e in state.all_symbols {
                if e.name != name {
                    updated_syms = updated_syms + [e]
                    updated_names = updated_names + [e.name]
                    new_map[e.name] = e

                    if list_has_string(new_all_files, e.file_path) {
                        new_file_map[e.file_path] = new_file_map[e.file_path] + [e]
                    } else {
                        new_file_map[e.file_path] = [e]
                        new_all_files = new_all_files + [e.file_path]
                    }

                    if list_has_string(new_all_kinds, e.kind) {
                        new_kind_map[e.kind] = new_kind_map[e.kind] + [e]
                    } else {
                        new_kind_map[e.kind] = [e]
                        new_all_kinds = new_all_kinds + [e.kind]
                    }

                    for eff in e.effects {
                        if list_has_string(new_all_effs, eff) {
                            new_eff_map[eff] = new_eff_map[eff] + [e]
                        } else {
                            new_eff_map[eff] = [e]
                            new_all_effs = new_all_effs + [eff]
                        }
                    }
                }
            }
            state.symbols = new_map
            state.symbol_names = updated_names
            state.all_symbols = updated_syms
            state.file_symbols = new_file_map
            state.all_files = new_all_files
            state.kind_symbols = new_kind_map
            state.all_kinds = new_all_kinds
            state.effect_symbols = new_eff_map
            state.all_effects = new_all_effs
            state.total_count = state.total_count - 1
            did_remove = true
        }
        did_remove
    }

    fn find_by_file(path: string) -> [SymbolEntry] {
        let mut res: [SymbolEntry] = []
        if list_has_string(state.all_files, path) {
            res = state.file_symbols[path]
        }
        res
    }

    fn find_by_kind(kind: string) -> [SymbolEntry] {
        let mut res: [SymbolEntry] = []
        if list_has_string(state.all_kinds, kind) {
            res = state.kind_symbols[kind]
        }
        res
    }

    fn find_by_effect(effect: string) -> [SymbolEntry] {
        let mut res: [SymbolEntry] = []
        if list_has_string(state.all_effects, effect) {
            res = state.effect_symbols[effect]
        }
        res
    }
}

fn main() -> int {
    SymbolTable.reset_symbol_table()
    let s: SymbolEntry = {
        name: "test_entry",
        kind: "fn",
        file_path: "/main.ndg",
        line: 1,
        signature: "fn test_entry()",
        effects: ["IO"]
    }
    SymbolTable.insert(s)
    let found = SymbolTable.lookup("test_entry")
    if found != none {
        0
    } else {
        1
    }
}

test "symbol table map insertion, lookup and remove" {
    SymbolTable.reset_symbol_table()
    let s1: SymbolEntry = {
        name: "compute",
        kind: "fn",
        file_path: "/math.ndg",
        line: 10,
        signature: "fn compute(x: int) -> int",
        effects: []
    }
    let s2: SymbolEntry = {
        name: "OrderAgent",
        kind: "agent",
        file_path: "/agents/order.ndg",
        line: 1,
        signature: "agent OrderAgent",
        effects: ["Store"]
    }
    let s3: SymbolEntry = {
        name: "delete_record",
        kind: "fn",
        file_path: "/db.ndg",
        line: 50,
        signature: "fn delete_record()",
        effects: ["WorkspaceDelete", "IO"]
    }

    SymbolTable.insert(s1)
    SymbolTable.insert(s2)
    SymbolTable.insert(s3)

    assert SymbolTable.count() == 3

    let l1 = SymbolTable.lookup("compute")
    assert l1 != none
    let l1_val = l1
    assert l1_val.kind == "fn"
    assert l1_val.line == 10

    let l2 = SymbolTable.lookup("OrderAgent")
    assert l2 != none
    let l2_val = l2
    assert l2_val.kind == "agent"

    let l_missing = SymbolTable.lookup("non_existent")
    assert l_missing == none

    let store_symbols = SymbolTable.find_by_effect("Store")
    assert len(store_symbols) == 1
    assert store_symbols[0].name == "OrderAgent"

    let delete_symbols = SymbolTable.find_by_effect("WorkspaceDelete")
    assert len(delete_symbols) == 1
    assert delete_symbols[0].name == "delete_record"

    let fn_symbols = SymbolTable.find_by_kind("fn")
    assert len(fn_symbols) == 2

    assert SymbolTable.remove("compute")
    assert SymbolTable.count() == 2
    assert SymbolTable.lookup("compute") == none
    assert SymbolTable.lookup("OrderAgent") != none
}
