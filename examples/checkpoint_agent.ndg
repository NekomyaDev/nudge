// Checkpointed agent (design §7, v0.2c): every state write is an automatic
// checkpoint under .nudge/runs/<run_id>/; after a crash,
// `nudge resume <run_id>` replays the recorded prefix and continues live.
//
//   nudgec build examples/checkpoint_agent.ndg
//   NUDGE_RUN_ID=demo-1 python3 out/checkpoint_agent.py     # crashes? then:
//   nudgec resume demo-1

agent Researcher {
    state {
        notes: [string] = [],
        round: int = 0,
    }

    fn step(q: string) -> string uses LLM {
        let note = llm"""One short research note about: {q}""" with { model: "anthropic:sonnet-4.6", budget: 0.01 USD }
        state.notes += [note]
        state.round += 1
        note
    }

    fn main() -> [string] uses LLM {
        step("urban heat islands")
        step("green roofs")
        state.notes
    }
}
