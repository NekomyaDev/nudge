// The smallest end-to-end Nudge program (roadmap day 1–3).
// Build:  nudgec build examples/hello_llm.ndg
// Run:    PYTHONPATH=runtime NUDGE_PROVIDER=fake python3 out/hello_llm.py

fn main() -> string uses LLM {
    llm"""Say hello to the Nudge language in one short sentence."""
    with { model: "anthropic:sonnet-4.6", budget: 0.01 USD }
}
