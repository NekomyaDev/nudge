// Scheduled Browser Watcher Example with Drift Detection
// Part of Phase F5.3 (docs/browser-roadmap.md)

type WatchResult = {
    url: string,
    drift_detected: bool,
    summary: string,
    action_fired: bool
}

fn check_page_and_alert_on_drift(body_text: string, expected: string) -> WatchResult {
    let has_drift = str.contains(body_text, "404") or (body_text != expected)
    let msg = if has_drift { "Drift or error detected" } else { "Clean page response" }

    {
        url: "https://example.com/status",
        drift_detected: has_drift,
        summary: msg,
        action_fired: false
    }
}

test "watcher checks page health and returns typed watch result" {
    let res = check_page_and_alert_on_drift("200 OK Status", "200 OK Status")
    assert !res.drift_detected
    assert res.summary == "Clean page response"
    assert !res.action_fired
}
