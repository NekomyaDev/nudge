// Real-provider smoke agent (design §4.6, v1.1a) — run by the
// provider-smoke workflow against the Gemini free tier: the model string's
// `gemini:` prefix routes the call through the OpenAI-compatible adapter.
type Smoke = { title: string, confidence: float }

fn main() -> string uses LLM {
    let r = llm"""Reply with a JSON object with a string field title and a number field confidence. Output only JSON."""
        with { schema: Smoke,
               model: "gemini:gemini-2.5-flash",
               budget: 0.05 USD }
    r.title
}
