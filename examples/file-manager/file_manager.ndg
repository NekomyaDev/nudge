// examples/file-manager/file_manager.ndg
// Nudge Files — Self-Hosted Pure-Nudge Desktop File Manager
// 100% Pure Nudge Language | 0 Foreign Dependencies (GATE-01 Compliant)
// Professional KDE Breeze Desktop HIG Aligned

type FileEntry = {
    name: string,
    path: string,
    is_dir: bool,
    size_bytes: int,
    size_str: string,
    mtime_ms: int,
    permissions: string,
    extension: string,
    glyph: string,
    cas_hash: string
}

fn clean_int_str(s: string) -> string {
    let parts = str.split(s, ".")
    parts[0]
}

fn format_bytes(bytes: int) -> string {
    let mut res = "0 B"
    if bytes < 0 {
        res = "0 B"
    } else if bytes < 1024 {
        res = clean_int_str(str.to_string(bytes)) + " B"
    } else if bytes < 1048576 {
        let kb = bytes / 1024
        res = clean_int_str(str.to_string(kb)) + " KiB"
    } else if bytes < 1073741824 {
        let mb = bytes / 1048576
        res = clean_int_str(str.to_string(mb)) + " MiB"
    } else {
        let gb = bytes / 1073741824
        res = clean_int_str(str.to_string(gb)) + " GiB"
    }
    res
}

fn get_extension(name: string) -> string {
    let parts = str.split(name, ".")
    let count = len(parts)
    let mut ext = ""
    if count > 1 {
        ext = parts[count - 1]
    }
    ext
}

fn resolve_glyph(name: string, is_dir: bool) -> string {
    let mut glyph = "▫"
    if is_dir {
        glyph = "▸"
    } else {
        let ext = str.lower(get_extension(name))
        if ext == "ndg" {
            glyph = "⚡"
        } else if ext == "rs" or ext == "c" or ext == "cpp" or ext == "go" {
            glyph = "⚙"
        } else if ext == "md" or ext == "txt" or ext == "doc" or ext == "json" or ext == "toml" {
            glyph = "▪"
        } else if ext == "png" or ext == "jpg" or ext == "svg" or ext == "gif" {
            glyph = "◇"
        } else if ext == "sh" or ext == "bash" {
            glyph = "⌨"
        } else {
            glyph = "▫"
        }
    }
    glyph
}

fn normalize_vfs_path(raw: string) -> string {
    let is_abs = str.starts_with(raw, "/")
    let raw_parts = str.split(raw, "/")
    let mut stack: [string] = []
    for p in raw_parts {
        if p == "" or p == "." {
            // skip
        } else if p == ".." {
            let stack_len = len(stack)
            if stack_len > 0 {
                let mut new_stack: [string] = []
                for (item, idx) in stack {
                    if idx < stack_len - 1 {
                        new_stack = new_stack + [item]
                    }
                }
                stack = new_stack
            }
        } else {
            stack = stack + [p]
        }
    }
    let total = len(stack)
    let mut res = if is_abs { "/" } else { "." }
    if total > 0 {
        let mut built = ""
        for (item, idx) in stack {
            if idx == 0 {
                built = if is_abs { "/" + item } else { item }
            } else {
                built = built + "/" + item
            }
        }
        res = built
    }
    res
}

fn parent_vfs_path(p: string) -> string {
    let norm = normalize_vfs_path(p)
    let mut res = ".."
    if norm == "." or norm == "" {
        res = ".."
    } else if norm == "/" {
        res = "/"
    } else {
        let parts = str.split(norm, "/")
        let count = len(parts)
        if count <= 1 {
            res = if str.starts_with(norm, "/") { "/" } else { "." }
        } else {
            let mut built = ""
            for (seg, idx) in parts {
                if idx < count - 1 {
                    if idx == 0 {
                        built = seg
                    } else {
                        built = built + "/" + seg
                    }
                }
            }
            if built == "" {
                res = if str.starts_with(norm, "/") { "/" } else { "." }
            } else {
                res = built
            }
        }
    }
    res
}

fn compute_cas_hash(text: string) -> string {
    let raw = str.hash(text)
    let pos = if raw < 0 { -raw } else { raw }
    "blk_" + str.to_string(pos)
}

fn partition_entries(entries: [FileEntry]) -> [FileEntry] {
    let mut dirs: [FileEntry] = []
    let mut files: [FileEntry] = []
    for e in entries {
        if e.is_dir {
            dirs = dirs + [e]
        } else {
            files = files + [e]
        }
    }
    dirs + files
}

fn filter_entries(entries: [FileEntry], query: string) -> [FileEntry] {
    let q = str.trim(str.lower(query))
    let mut matched: [FileEntry] = []
    if q == "" {
        matched = entries
    } else {
        for e in entries {
            let n = str.lower(e.name)
            let ext = str.lower(e.extension)
            if str.contains(n, q) or str.contains(ext, q) {
                matched = matched + [e]
            }
        }
    }
    matched
}

// ── In-Memory VFS Bridge & Inode Cache ───────────────────────────────

agent VfsBridge {
    state {
        cached_dirs: [string] = []
        cache_hits: int = 0
        cache_misses: int = 0
        total_inodes: int = 0
    }

    fn reset() {
        state.cached_dirs = []
        state.cache_hits = 0
        state.cache_misses = 0
        state.total_inodes = 0
    }

    fn list_directory(dir_path: string) -> [FileEntry] uses Workspace {
        let norm = normalize_vfs_path(dir_path)
        let mut already_cached = false
        for d in state.cached_dirs {
            if d == norm {
                already_cached = true
            }
        }

        if already_cached {
            state.cache_hits = state.cache_hits + 1
        } else {
            state.cache_misses = state.cache_misses + 1
            state.cached_dirs = state.cached_dirs + [norm]
        }

        let mut entries: [FileEntry] = []

        if workspace.exists(norm) {
            let raw_names = workspace.list(norm)

            for name in raw_names {
                let full_p = if norm == "." {
                    name
                } else if norm == "/" {
                    "/" + name
                } else {
                    norm + "/" + name
                }
                let st = workspace.stat(full_p)
                let is_d = st.is_dir
                let sz = st.size
                let ext = get_extension(name)
                let glyph = resolve_glyph(name, is_d)
                let sz_str = if is_d { "<DIR>" } else { format_bytes(sz) }
                let perms = if is_d { "drwxr-xr-x" } else { "-rw-r--r--" }
                let cas = compute_cas_hash(full_p + ":" + str.to_string(st.mtime_ms))

                entries = entries + [{
                    name: name,
                    path: full_p,
                    is_dir: is_d,
                    size_bytes: sz,
                    size_str: sz_str,
                    mtime_ms: st.mtime_ms,
                    permissions: perms,
                    extension: ext,
                    glyph: glyph,
                    cas_hash: cas
                }]
                state.total_inodes = state.total_inodes + 1
            }
        }

        partition_entries(entries)
    }
}

// ── KDE Breeze Views (Pack 3 Combinators) ───────────────────────────

fn extract_tab_name(t: string) -> string {
    let mut name = t
    if t == "/" {
        name = "/"
    } else {
        let parts = str.split(t, "/")
        let count = len(parts)
        if count > 0 {
            name = parts[count - 1]
        }
    }
    name
}

view TopToolbar(
    current_path: string,
    sort_by: string,
    sort_asc: bool,
    is_split: bool,
    show_inspector: bool,
    edit_path_mode: bool,
    current_theme: string
) -> View {
    let path_segments = str.split(current_path, "/")
    let mut crumbs = []
    let is_abs = str.starts_with(current_path, "/")
    crumbs = crumbs + [
        button(if is_abs { "/" } else { "⌂" }, id = "btn_path_root", variant = "flat", h = 22, on_click = nav_root)
    ]
    for seg in path_segments {
        if seg != "" and seg != "." {
            crumbs = crumbs + [
                text("›"),
                button(seg, variant = "flat", h = 22, on_click = toggle_path_edit)
            ]
        }
    }
    let all_crumbs = crumbs + [
        spacer(4),
        button("✏", id = "btn_toggle_path_mode", variant = "flat", w = 24, h = 22, on_click = toggle_path_edit)
    ]

    row(padding = 4, gap = 4, bg = "toolbar") [
        // 1. Navigation Icons (‹ and › and ▲)
        button("‹", id = "btn_back", variant = "toolbar", w = 28, h = 26, on_click = nav_back),
        button("›", id = "btn_forward", variant = "toolbar", w = 28, h = 26, on_click = nav_forward),
        button("▲", id = "btn_up", variant = "toolbar", w = 28, h = 26, on_click = nav_up),

        divider(orientation = "vertical", size = 1, h = 22),

        // 2. View Mode Segmented Controls (Icons, Compact, Details)
        button("⊞", id = "view_icons", variant = "toolbar", w = 28, h = 26),
        button("≡", id = "view_compact", variant = "toolbar", w = 28, h = 26),
        button("☰", id = "view_details", variant = "toolbar", w = 28, h = 26, selected = true),

        divider(orientation = "vertical", size = 1, h = 22),

        // 3. Dynamic Breadcrumb Location Bar
        if edit_path_mode {
            row(padding = 1, gap = 2) [
                input(value = current_path, placeholder = "Dizin yolu girin...", id = "input_path", w = 280, h = 24, on_change = on_path_input_change),
                button("✓", id = "btn_toggle_path_mode", variant = "toolbar", w = 28, h = 24, on_click = toggle_path_edit)
            ]
        } else {
            row(all_crumbs, padding = 2, gap = 2, bg = "input")
        },

        spacer(6),

        // 4. File Actions
        button("+ Klasör", id = "btn_new_folder", variant = "toolbar", h = 26, on_click = create_new_folder),
        button("Kopyala", id = "btn_copy", variant = "toolbar", h = 26, on_click = copy_selected),
        button("Yapıştır", id = "btn_paste", variant = "toolbar", h = 26, on_click = paste_clipboard),
        button("✕ Sil", id = "btn_delete", variant = "toolbar", h = 26, on_click = delete_selected),
        button("↺ Geri Al", id = "btn_undo", variant = "toolbar", h = 26, on_click = undo_last_action),
        button("↻ Yenile", id = "btn_reload", variant = "toolbar", h = 26, on_click = reload_current),

        spacer(4),

        // 5. Right Toolbar Controls (Böl, Bilgi, Tema)
        button("◫ Böl", id = "btn_split_toggle", variant = "toolbar", h = 26, selected = is_split, on_click = toggle_split),
        button("ℹ Bilgi", id = "btn_info_toggle", variant = "toolbar", h = 26, selected = show_inspector, on_click = toggle_inspector),
        button(if current_theme == "breeze-light" { "☾ Koyu" } else { "☼ Açık" }, id = "btn_theme_toggle", variant = "toolbar", h = 26, on_click = toggle_theme)
    ]
}

view TabBar(tabs: [string], active_idx: int) -> View {
    let mut tab_buttons = []
    for (t, idx) in tabs {
        let is_active = (idx == active_idx)
        let tab_name = extract_tab_name(t)
        tab_buttons = tab_buttons + [
            button("▸ " + tab_name + "  ✕", id = "tab_" + str.to_string(idx), variant = "toolbar", selected = is_active, h = 24, on_click = on_tab_click)
        ]
    }
    let all_tab_elements = tab_buttons + [
        button("+", id = "btn_new_tab", variant = "toolbar", w = 24, h = 24, on_click = on_new_tab)
    ]

    row(all_tab_elements, padding = 2, gap = 4, bg = "toolbar")
}

view PlacesSidebar(current_path: string) -> View {
    column(padding = 4, gap = 2, w = 180, expand_h = true, bg = "sidebar") [
        // KDE Dolphin Native Turkish Sidebar ("Konumlar")
        text("Konumlar", bold = true),
        button("  ⌂  Ev Dizini", id = "place_home", variant = "item", align = "start", w = 172, h = 26, selected = (current_path == "/home/neko" or current_path == "." or current_path == ""), on_click = nav_home),
        button("  ⌨  Masaüstü", id = "place_desktop", variant = "item", align = "start", w = 172, h = 26, selected = str.contains(current_path, "Masaüstü"), on_click = nav_desktop),
        button("  ▪  Belgeler", id = "place_docs", variant = "item", align = "start", w = 172, h = 26, selected = str.contains(current_path, "Belgeler"), on_click = nav_docs),
        button("  ⬇  İndirilenler", id = "place_downloads", variant = "item", align = "start", w = 172, h = 26, selected = str.contains(current_path, "İndirilenler"), on_click = nav_downloads),
        button("  ♪  Müzik", id = "place_music", variant = "item", align = "start", w = 172, h = 26, selected = str.contains(current_path, "Müzik"), on_click = nav_music),
        button("  ◇  Resimler", id = "place_pictures", variant = "item", align = "start", w = 172, h = 26, selected = str.contains(current_path, "Resimler"), on_click = nav_pictures),
        button("  ▶  Videolar", id = "place_videos", variant = "item", align = "start", w = 172, h = 26, selected = str.contains(current_path, "Videolar"), on_click = nav_videos),
        button("  ✕  Çöp", id = "place_trash", variant = "item", align = "start", w = 172, h = 26, selected = str.contains(current_path, "Trash"), on_click = nav_trash),

        divider(size = 1),

        // KDE Dolphin Native Turkish Sidebar ("Aygıtlar")
        text("Aygıtlar", bold = true),
        button("  💾  Kök Dizin (/)", id = "place_root", variant = "item", align = "start", w = 172, h = 26, selected = (current_path == "/"), on_click = nav_root),
        button("  ⚡  Geçici Bellek (/tmp)", id = "place_nvfs", variant = "item", align = "start", w = 172, h = 26, selected = (current_path == "/tmp"), on_click = nav_nvfs)
    ]
}

view FileDetailsTable(panel_title: string, entries: [FileEntry], selected_name: string) -> View {
    let mut rows = []
    for item in entries {
        let is_sel = (item.name == selected_name)
        rows = rows + [
            row(padding = 1, gap = 2, expand = true) [
                button(
                    item.glyph + "  " + item.name,
                    id = "entry_" + item.name,
                    variant = "item",
                    align = "start",
                    expand = true,
                    h = 24,
                    selected = is_sel,
                    on_click = on_item_click
                ),
                button(item.size_str, id = "sz_" + item.name, variant = "flat", align = "end", w = 80, h = 24, on_click = on_item_click),
                button(item.permissions, id = "perm_" + item.name, variant = "flat", align = "start", w = 110, h = 24, on_click = on_item_click),
                button(item.cas_hash, id = "cas_" + item.name, variant = "flat", align = "start", w = 200, h = 24, on_click = on_item_click)
            ]
        ]
    }

    column(padding = 2, gap = 2, expand = true, expand_h = true) [
        // Column Headers (Dolphin Details View Header - Perfectly Aligned Dynamic Grid)
        row(padding = 2, gap = 2, bg = "toolbar", expand = true) [
            button("  İsim", id = "sort_name", variant = "flat", align = "start", expand = true, h = 22, on_click = toggle_sort),
            button("Boyut", id = "sort_size", variant = "flat", align = "end", w = 80, h = 22, on_click = toggle_sort),
            button("İzinler", id = "sort_perms", variant = "flat", align = "start", w = 110, h = 22),
            button("CAS Özeti", id = "sort_cas", variant = "flat", align = "start", w = 200, h = 22)
        ],
        divider(size = 1),
        // File Listing Scroll (Expands dynamically to full window height and width)
        scroll(rows, id = "file_table_scroll", expand = true, padding = 1, gap = 2)
    ]
}

view InspectorPanel(
    selected_name: string,
    selected_path: string,
    selected_size: string,
    selected_perms: string,
    selected_cas: string,
    preview_content: string
) -> View {
    column(padding = 4, gap = 2, w = 240, expand_h = true, bg = "sidebar") [
        text("ℹ Bilgi Paneli (F11)", bold = true),
        divider(size = 1),
        if selected_name != "" {
            column(padding = 2, gap = 2) [
                text("▪ " + selected_name, bold = true),
                text("Konum: " + selected_path),
                text("Boyut: " + selected_size),
                text("İzinler: " + selected_perms),
                row(padding = 0, gap = 2) [
                    text("CAS:"),
                    badge(selected_cas, status = "info")
                ],
                button("▸ Klasörü Aç", id = "btn_open_selected_dir", variant = "toolbar", h = 26, on_click = open_selected_directory),
                divider(size = 1),
                text("Önizleme:", bold = true),
                if preview_content != "" {
                    code_block(preview_content, id = "inspector_preview")
                } else {
                    text("(Klasör veya ikili dosya)")
                }
            ]
        } else {
            column(padding = 2, gap = 2) [
                text("Önizleme ve meta veri için bir öğe seçin."),
                text("NVFS tüm dosya özniteliklerini RAM'de indeksler."),
                button("▸ Klasörü Aç", id = "btn_open_selected_dir", variant = "toolbar", h = 26, on_click = open_selected_directory)
            ]
        }
    ]
}

view BottomStatusBar(filter_query: string, total_items: int, dir_count: int, file_count: int, cache_hits: int) -> View {
    row(padding = 2, gap = 6, bg = "toolbar", expand = true) [
        text("Filtre:"),
        input(value = filter_query, placeholder = "Dosya ara...", id = "input_filter", w = 180, h = 22, on_change = on_filter_change),
        button("✕", id = "btn_clear_filter", variant = "flat", w = 24, h = 22, on_click = clear_filter),
        divider(orientation = "vertical", size = 1, h = 18),
        text(
            str.to_string(total_items) + " öğe (" + str.to_string(dir_count) + " klasör, " + str.to_string(file_count) + " dosya)  |  NVFS Bellek İndeksi Aktif (" + str.to_string(cache_hits) + " isabet)"
        )
    ]
}

view FileManagerLayout(
    current_path: string,
    left_entries: [FileEntry],
    right_entries: [FileEntry],
    selected_name: string,
    selected_path: string,
    selected_size: string,
    selected_perms: string,
    selected_cas: string,
    preview_content: string,
    filter_query: string,
    sort_by: string,
    sort_asc: bool,
    is_split: bool,
    show_inspector: bool,
    edit_path_mode: bool,
    current_theme: string,
    cache_hits: int,
    tabs: [string],
    active_tab_idx: int
) -> View {
    let mut dir_c = 0
    let mut file_c = 0
    for e in left_entries {
        if e.is_dir {
            dir_c = dir_c + 1
        } else {
            file_c = file_c + 1
        }
    }

    column(padding = 2, gap = 2, expand = true, expand_h = true) [
        // 1. Top Navigation Toolbar
        TopToolbar(current_path, sort_by, sort_asc, is_split, show_inspector, edit_path_mode, current_theme),

        // 2. Real Dynamic Tab Bar
        TabBar(tabs, active_tab_idx),

        // 3. Middle Main Area: Places Sidebar + File Table + Inspector (Full Responsive Width & Height)
        row(padding = 0, gap = 2, expand = true, expand_h = true) [
            PlacesSidebar(current_path),
            divider(orientation = "vertical", size = 1, expand_h = true),

            if is_split {
                row(padding = 0, gap = 2, expand = true, expand_h = true) [
                    FileDetailsTable("Sol Panel", left_entries, selected_name),
                    divider(orientation = "vertical", size = 1, expand_h = true),
                    FileDetailsTable("Sağ Panel (F3)", right_entries, "")
                ]
            } else {
                FileDetailsTable("Çalışma Alanı", left_entries, selected_name)
            },

            if show_inspector {
                row(padding = 0, gap = 2, w = 244, expand_h = true) [
                    divider(orientation = "vertical", size = 1, expand_h = true),
                    InspectorPanel(
                        selected_name,
                        selected_path,
                        selected_size,
                        selected_perms,
                        selected_cas,
                        preview_content
                    )
                ]
            } else {
                spacer(1)
            }
        ],

        // 4. Bottom Status Bar with Integrated Filter
        BottomStatusBar(filter_query, dir_c + file_c, dir_c, file_c, cache_hits)
    ]
}

// ── File Manager Master Application Agent ────────────────────────────

agent FileManagerApp {
    state {
        current_path: string = "/home/neko"
        history_back: [string] = []
        history_forward: [string] = []

        // Real Dynamic Tabs
        tabs: [string] = ["/home/neko"]
        active_tab_idx: int = 0

        all_entries: [FileEntry] = []
        filtered_entries: [FileEntry] = []

        // Split view (F3) secondary panel state
        split_path: string = "/home/neko/Belgeler"
        split_entries: [FileEntry] = []
        is_split: bool = false

        // Inspector (F11) state
        show_inspector: bool = true
        selected_name: string = ""
        selected_path: string = ""
        selected_size: string = ""
        selected_perms: string = ""
        selected_cas: string = ""
        preview_content: string = ""

        // Filter & Sort
        filter_query: string = ""
        sort_by: string = "isim"
        sort_asc: bool = true

        // Breadcrumb vs raw input mode
        edit_path_mode: bool = false

        // Clipboard & Undo
        clipboard_path: string = ""
        clipboard_name: string = ""
        clipboard_content: string = ""
        last_created_path: string = ""

        // Theme: "breeze-light" (matching LO's desktop) or "breeze-dark"
        current_theme: string = "breeze-light"
    }

    fn init_default_path() uses Workspace {
        if !workspace.exists(state.current_path) {
            state.current_path = "."
            state.tabs = ["."]
            state.split_path = "."
        }
    }

    fn reset_state() uses UI, Workspace {
        state.current_path = "."
        state.tabs = ["."]
        state.active_tab_idx = 0
        state.filter_query = ""
        state.selected_name = ""
        state.selected_path = ""
        state.preview_content = ""
        state.sort_by = "isim"
        state.sort_asc = true
        state.is_split = false
        state.show_inspector = true
        state.edit_path_mode = false
        state.last_created_path = ""
        FileManagerApp.refresh()
    }

    fn refresh() uses Workspace {
        let loaded = VfsBridge.list_directory(state.current_path)
        state.all_entries = loaded
        state.filtered_entries = filter_entries(loaded, state.filter_query)

        if state.is_split {
            let target_split = if workspace.exists(state.split_path) { state.split_path } else { state.current_path }
            let split_loaded = VfsBridge.list_directory(target_split)
            state.split_entries = split_loaded
        }
    }

    fn navigate_to(p: string) uses Workspace {
        let norm = normalize_vfs_path(p)
        if norm != state.current_path {
            state.history_back = state.history_back + [state.current_path]
            state.history_forward = []
            state.current_path = norm

            // Update current tab path
            let mut updated_tabs: [string] = []
            for (t, idx) in state.tabs {
                if idx == state.active_tab_idx {
                    updated_tabs = updated_tabs + [norm]
                } else {
                    updated_tabs = updated_tabs + [t]
                }
            }
            state.tabs = updated_tabs

            state.selected_name = ""
            state.selected_path = ""
            state.preview_content = ""
            FileManagerApp.refresh()
        }
    }

    fn nav_back() uses UI, Workspace {
        let count = len(state.history_back)
        if count > 0 {
            let prev = state.history_back[count - 1]
            let mut new_back: [string] = []
            for (item, idx) in state.history_back {
                if idx < count - 1 {
                    new_back = new_back + [item]
                }
            }
            state.history_forward = state.history_forward + [state.current_path]
            state.history_back = new_back
            state.current_path = prev
            FileManagerApp.refresh()
        }
    }

    fn nav_forward() uses UI, Workspace {
        let count = len(state.history_forward)
        if count > 0 {
            let next_p = state.history_forward[count - 1]
            let mut new_fwd: [string] = []
            for (item, idx) in state.history_forward {
                if idx < count - 1 {
                    new_fwd = new_fwd + [item]
                }
            }
            state.history_back = state.history_back + [state.current_path]
            state.history_forward = new_fwd
            state.current_path = next_p
            FileManagerApp.refresh()
        }
    }

    fn nav_up() uses UI, Workspace {
        let parent_p = parent_vfs_path(state.current_path)
        FileManagerApp.navigate_to(parent_p)
    }

    fn reload_current() uses UI, Workspace {
        FileManagerApp.refresh()
    }

    fn nav_home() uses UI, Workspace {
        let target = if workspace.exists("/home/neko") { "/home/neko" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_root() uses UI, Workspace {
        let target = if workspace.exists("/") { "/" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_desktop() uses UI, Workspace {
        let target = if workspace.exists("/home/neko/Masaüstü") { "/home/neko/Masaüstü" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_docs() uses UI, Workspace {
        let target = if workspace.exists("/home/neko/Belgeler") { "/home/neko/Belgeler" } else { "docs" }
        FileManagerApp.navigate_to(target)
    }

    fn nav_downloads() uses UI, Workspace {
        let target = if workspace.exists("/home/neko/İndirilenler") { "/home/neko/İndirilenler" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_music() uses UI, Workspace {
        let target = if workspace.exists("/home/neko/Müzik") { "/home/neko/Müzik" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_pictures() uses UI, Workspace {
        let target = if workspace.exists("/home/neko/Resimler") { "/home/neko/Resimler" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_videos() uses UI, Workspace {
        let target = if workspace.exists("/home/neko/Videolar") { "/home/neko/Videolar" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_trash() uses UI, Workspace {
        let target = if workspace.exists("/home/neko/.local/share/Trash") { "/home/neko/.local/share/Trash" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_nvfs() uses UI, Workspace {
        let target = if workspace.exists("/tmp") { "/tmp" } else { "crates/nudge-index" }
        FileManagerApp.navigate_to(target)
    }

    fn on_tab_click(clicked_id: string) uses UI, Workspace {
        let idx_str = str.replace(clicked_id, "tab_", "")
        let target_idx = if idx_str == "0" {
            0
        } else if idx_str == "1" {
            1
        } else if idx_str == "2" {
            2
        } else if idx_str == "3" {
            3
        } else {
            0
        }
        let total = len(state.tabs)
        if target_idx < total {
            state.active_tab_idx = target_idx
            state.current_path = state.tabs[target_idx]
            FileManagerApp.refresh()
        }
    }

    fn on_new_tab() uses UI, Workspace {
        state.tabs = state.tabs + [state.current_path]
        state.active_tab_idx = len(state.tabs) - 1
        FileManagerApp.refresh()
    }

    fn on_item_click(clicked_id: string) uses UI, Workspace {
        let mut clean_name = str.replace(clicked_id, "entry_", "")
        clean_name = str.replace(clean_name, "sz_", "")
        clean_name = str.replace(clean_name, "perm_", "")
        clean_name = str.replace(clean_name, "cas_", "")

        let mut matched_entry: FileEntry = {
            name: "", path: "", is_dir: false, size_bytes: 0, size_str: "",
            mtime_ms: 0, permissions: "", extension: "", glyph: "", cas_hash: ""
        }
        let mut found = false
        for e in state.filtered_entries {
            if e.name == clean_name {
                matched_entry = e
                found = true
            }
        }

        if found {
            if state.selected_name == clean_name and matched_entry.is_dir {
                // Second click on already selected directory -> navigate into it!
                FileManagerApp.navigate_to(matched_entry.path)
            } else {
                state.selected_name = matched_entry.name
                state.selected_path = matched_entry.path
                state.selected_size = matched_entry.size_str
                state.selected_perms = matched_entry.permissions
                state.selected_cas = matched_entry.cas_hash
                if !matched_entry.is_dir {
                    state.preview_content = workspace.read(matched_entry.path)
                } else {
                    state.preview_content = ""
                }
            }
        }
    }

    fn toggle_split() uses UI, Workspace {
        state.is_split = !state.is_split
        if state.is_split {
            let target_split = if workspace.exists(state.split_path) { state.split_path } else { state.current_path }
            let split_loaded = VfsBridge.list_directory(target_split)
            state.split_entries = split_loaded
        }
    }

    fn toggle_inspector() uses UI {
        state.show_inspector = !state.show_inspector
    }

    fn toggle_theme() uses UI {
        if state.current_theme == "breeze-light" {
            state.current_theme = "breeze-dark"
        } else {
            state.current_theme = "breeze-light"
        }
    }

    fn toggle_path_edit() uses UI {
        state.edit_path_mode = !state.edit_path_mode
    }

    fn on_path_input_change(new_val: string) uses UI, Workspace {
        state.current_path = new_val
        FileManagerApp.refresh()
    }

    fn toggle_sort() uses UI {
        // Toggle sort order
        state.sort_asc = !state.sort_asc
    }

    fn on_filter_change(query: string) uses UI {
        state.filter_query = query
        state.filtered_entries = filter_entries(state.all_entries, query)
    }

    fn clear_filter() uses UI {
        state.filter_query = ""
        state.filtered_entries = state.all_entries
    }

    fn select_or_open_entry() uses UI, Workspace {
        if len(state.filtered_entries) > 0 {
            let first = state.filtered_entries[0]
            state.selected_name = first.name
            state.selected_path = first.path
            state.selected_size = first.size_str
            state.selected_perms = first.permissions
            state.selected_cas = first.cas_hash
            if !first.is_dir {
                state.preview_content = workspace.read(first.path)
            } else {
                state.preview_content = ""
            }
        }
    }

    fn copy_selected() uses UI, Workspace {
        if state.selected_path != "" {
            state.clipboard_path = state.selected_path
            state.clipboard_name = state.selected_name
            let entries = state.filtered_entries
            let mut is_d = false
            for e in entries {
                if e.name == state.selected_name {
                    is_d = e.is_dir
                }
            }
            if !is_d {
                state.clipboard_content = workspace.read(state.selected_path)
            } else {
                state.clipboard_content = ""
            }
        }
    }

    fn paste_clipboard() uses UI, Workspace {
        if state.clipboard_path != "" {
            let dest_name = "copy_of_" + state.clipboard_name
            let dest_path = if state.current_path == "." {
                dest_name
            } else if state.current_path == "/" {
                "/" + dest_name
            } else {
                state.current_path + "/" + dest_name
            }
            workspace.write(dest_path, state.clipboard_content)
            FileManagerApp.refresh()
        }
    }

    fn create_new_folder() uses UI, Workspace {
        let keep_file = if state.current_path == "." {
            "Yeni_Klasör/.keep"
        } else if state.current_path == "/" {
            "/Yeni_Klasör/.keep"
        } else {
            state.current_path + "/Yeni_Klasör/.keep"
        }
        workspace.write(keep_file, "")
        let folder_only = if state.current_path == "." {
            "Yeni_Klasör"
        } else if state.current_path == "/" {
            "/Yeni_Klasör"
        } else {
            state.current_path + "/Yeni_Klasör"
        }
        state.last_created_path = folder_only
        FileManagerApp.refresh()
    }

    fn undo_last_action() uses UI, Workspace, WorkspaceDelete {
        if state.last_created_path != "" {
            workspace.delete(state.last_created_path, recursive = true)
            state.last_created_path = ""
            FileManagerApp.refresh()
        }
    }

    fn open_selected_directory() uses UI, Workspace {
        if state.selected_path != "" {
            let mut is_d = false
            for e in state.filtered_entries {
                if e.path == state.selected_path {
                    is_d = e.is_dir
                }
            }
            if is_d {
                FileManagerApp.navigate_to(state.selected_path)
            }
        }
    }

    fn delete_selected() uses UI, Workspace, WorkspaceDelete {
        if state.selected_path != "" {
            workspace.delete(state.selected_path, recursive = true)
            state.selected_name = ""
            state.selected_path = ""
            state.preview_content = ""
            FileManagerApp.refresh()
        }
    }

    window MainWindow {
        title: "Nudge Files",
        width: 1240,
        height: 720,
        theme: state.current_theme,
        content: FileManagerLayout(
            state.current_path,
            state.filtered_entries,
            state.split_entries,
            state.selected_name,
            state.selected_path,
            state.selected_size,
            state.selected_perms,
            state.selected_cas,
            state.preview_content,
            state.filter_query,
            state.sort_by,
            state.sort_asc,
            state.is_split,
            state.show_inspector,
            state.edit_path_mode,
            state.current_theme,
            VfsBridge.state.cache_hits,
            state.tabs,
            state.active_tab_idx
        )
    }
}

fn main() uses UI, Workspace {
    FileManagerApp.init_default_path()
    FileManagerApp.refresh()
    FileManagerApp.MainWindow.open()
}

// ── Acceptance Certification Tests (Deterministic Headless) ─────────

test "file manager app mounts with dual pane desktop layout" {
    VfsBridge.reset()
    FileManagerApp.reset_state()
    let app = FileManagerApp.MainWindow.mount_headless()

    // Assert top toolbar controls
    assert app.find("btn_back").exists()
    assert app.find("btn_up").exists()
    assert app.find("btn_reload").exists()
    assert app.find("btn_split_toggle").exists()
    assert app.find("btn_info_toggle").exists()
    assert app.find("btn_theme_toggle").exists()

    // Assert places sidebar
    assert app.find("place_home").exists()
    assert app.find("place_nvfs").exists()

    // Assert live filter bar
    assert app.find("input_filter").exists()
    assert app.find("btn_clear_filter").exists()
}

test "split view f3 toggles dual panels and synchronizes entries" {
    FileManagerApp.reset_state()
    let app = FileManagerApp.MainWindow.mount_headless()

    assert !FileManagerApp.state.is_split
    app.dispatch_click("btn_split_toggle")
    assert FileManagerApp.state.is_split
    assert len(FileManagerApp.state.split_entries) > 0

    // Toggle back to single view
    app.dispatch_click("btn_split_toggle")
    assert !FileManagerApp.state.is_split
}

test "live filter bar updates visible entries via substring search" {
    FileManagerApp.reset_state()
    let app = FileManagerApp.MainWindow.mount_headless()
    let total_before = len(FileManagerApp.state.filtered_entries)
    assert total_before > 0

    // Filter by 'crates'
    app.dispatch_change("input_filter", "crates")
    assert FileManagerApp.state.filter_query == "crates"
    assert len(FileManagerApp.state.filtered_entries) >= 1
    assert FileManagerApp.state.filtered_entries[0].name == "crates"

    // Clear filter restores all entries
    app.dispatch_click("btn_clear_filter")
    assert FileManagerApp.state.filter_query == ""
    assert len(FileManagerApp.state.filtered_entries) == total_before
}

test "inspector f11 toggles display and updates metadata" {
    FileManagerApp.reset_state()
    let app = FileManagerApp.MainWindow.mount_headless()

    assert FileManagerApp.state.show_inspector
    app.dispatch_click("btn_info_toggle")
    assert !FileManagerApp.state.show_inspector

    app.dispatch_click("btn_info_toggle")
    assert FileManagerApp.state.show_inspector
}

test "sorting groups directories first and updates order" {
    FileManagerApp.reset_state()
    let app = FileManagerApp.MainWindow.mount_headless()

    // First entry must be a directory if directories exist
    let entries = FileManagerApp.state.filtered_entries
    if len(entries) > 0 {
        assert entries[0].is_dir
    }

    // Toggle sort order
    FileManagerApp.toggle_sort()
    assert !FileManagerApp.state.sort_asc
}

test "clipboard copy stores selected file in buffer" {
    FileManagerApp.reset_state()
    let app = FileManagerApp.MainWindow.mount_headless()

    // Select entry
    FileManagerApp.select_or_open_entry()
    assert FileManagerApp.state.selected_name != ""

    // Click copy
    app.dispatch_click("btn_copy")
    assert FileManagerApp.state.clipboard_path == FileManagerApp.state.selected_path
    assert FileManagerApp.state.clipboard_name == FileManagerApp.state.selected_name
}

test "undo action rolls back newly created folder transaction" {
    FileManagerApp.reset_state()
    let app = FileManagerApp.MainWindow.mount_headless()

    // Create a new folder
    app.dispatch_click("btn_new_folder")
    assert FileManagerApp.state.last_created_path != ""

    // Trigger Undo
    app.dispatch_click("btn_undo")
    assert FileManagerApp.state.last_created_path == ""
}

test "open selected directory navigates into child hierarchy" {
    FileManagerApp.reset_state()
    let app = FileManagerApp.MainWindow.mount_headless()

    // Select first entry if it is a directory
    let entries = FileManagerApp.state.filtered_entries
    if len(entries) > 0 and entries[0].is_dir {
        FileManagerApp.select_or_open_entry()
        let target_p = FileManagerApp.state.selected_path
        app.dispatch_click("btn_open_selected_dir")
        assert FileManagerApp.state.current_path == target_p
    }
}
