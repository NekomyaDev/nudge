// examples/file-manager/src/07_status_bar.ndg
// Status Bar & Search Filter Bar with Disk Space & Zoom Status

view BottomStatusBar(
    filter_query: string,
    total_items: int,
    dir_count: int,
    file_count: int,
    selected_name: string,
    selected_size: string,
    current_lang: string,
    zoom_pct: int
) -> View {
    let summary = if selected_name != "" {
        "1 " + i18n("selected", current_lang) + ": " + selected_name + " (" + selected_size + ")"
    } else {
        str.to_string(total_items) + " " + i18n("items", current_lang) + " (" + str.to_string(dir_count) + " " + i18n("folder", current_lang) + ", " + str.to_string(file_count) + " " + i18n("file", current_lang) + ")"
    }

    let zoom_text = str.to_string(zoom_pct) + "%"
    let free_text = "4.0 TiB " + i18n("free", current_lang)

    row(padding = 2, gap = 4, bg = "toolbar", expand = true) [
        text("Filter:"),
        input(value = filter_query, placeholder = "Filter...", id = "input_filter", w = 120, h = 22, on_change = on_filter_change),
        button("✕", id = "btn_clear_filter", variant = "flat", w = 20, h = 22, on_click = clear_filter),
        divider(orientation = "vertical", size = 1, h = 18),
        text(summary),
        spacer(1),
        divider(orientation = "vertical", size = 1, h = 18),
        button("−", id = "btn_zoom_out", variant = "flat", w = 20, h = 20, on_click = zoom_out),
        text(zoom_text),
        button("+", id = "btn_zoom_in", variant = "flat", w = 20, h = 20, on_click = zoom_in),
        divider(orientation = "vertical", size = 1, h = 18),
        text(free_text)
    ]
}

view TerminalPanel(current_path: string, history: [string], input_val: string) -> View {
    column(padding = 4, gap = 2, h = 160, bg = "sidebar", expand = true) [
        row(padding = 2, gap = 4, bg = "toolbar", expand = true) [
            text(" >_ Terminal — neko@desktop:" + current_path, bold = true),
            spacer(1),
            button("✕", id = "btn_terminal_close", variant = "flat", w = 22, h = 20, on_click = toggle_terminal)
        ],
        scroll(history, id = "terminal_history_scroll", expand = true, padding = 2, gap = 1),
        row(padding = 2, gap = 2, expand = true) [
            text("$", bold = true),
            input(value = input_val, placeholder = "Enter command (ls, pwd, cd, mkdir, clear)...", id = "input_terminal", expand = true, h = 24, on_change = on_terminal_input_change),
            button("Exec", id = "btn_terminal_exec", variant = "toolbar", w = 50, h = 24, on_click = on_terminal_submit)
        ]
    ]
}

view FileManagerLayout(
    current_path: string,
    left_entries: [FileEntry],
    right_entries: [FileEntry],
    selected_name: string,
    selected_path: string,
    selected_size: string,
    selected_perms: string,
    selected_cas: string,
    preview_content: string,
    filter_query: string,
    is_split: bool,
    show_inspector: bool,
    show_hidden: bool,
    edit_path_mode: bool,
    current_theme: string,
    current_lang: string,
    view_mode: string,
    tabs: [string],
    active_tab_idx: int,
    show_terminal: bool,
    terminal_history: [string],
    terminal_input: string,
    zoom_pct: int
) -> View {
    let mut dir_c = 0
    let mut file_c = 0
    for e in left_entries {
        if e.is_dir {
            dir_c = dir_c + 1
        } else {
            file_c = file_c + 1
        }
    }

    column(padding = 0, gap = 0, expand = true, expand_h = true) [
        // 1. Top Navigation Toolbar (Edge to edge)
        TopToolbar(current_path, is_split, show_inspector, show_hidden, edit_path_mode, current_theme, current_lang, view_mode, show_terminal),

        // 2. Tab Bar (Edge to edge)
        TabBar(tabs, active_tab_idx),

        // 3. Middle Main Area: Places Sidebar + Active View Mode + Inspector
        row(padding = 0, gap = 0, expand = true, expand_h = true) [
            PlacesSidebar(current_path, current_lang),
            divider(orientation = "vertical", size = 1, expand_h = true),

            if is_split {
                row(padding = 0, gap = 2, expand = true, expand_h = true) [
                    column(padding = 0, gap = 0, expand = true, expand_h = true) [
                        if view_mode == "icons" {
                            FileIconsGrid(left_entries, selected_name, current_lang, zoom_pct)
                        } else if view_mode == "compact" {
                            FileCompactGrid(left_entries, selected_name, current_lang, zoom_pct)
                        } else {
                            FileDetailsTable("Left", left_entries, selected_name, current_lang)
                        }
                    ],
                    divider(orientation = "vertical", size = 1, expand_h = true),
                    column(padding = 0, gap = 0, expand = true, expand_h = true) [
                        if view_mode == "icons" {
                            FileIconsGrid(right_entries, "", current_lang, zoom_pct)
                        } else if view_mode == "compact" {
                            FileCompactGrid(right_entries, "", current_lang, zoom_pct)
                        } else {
                            FileDetailsTable("Right", right_entries, "", current_lang)
                        }
                    ]
                ]
            } else {
                if view_mode == "icons" {
                    FileIconsGrid(left_entries, selected_name, current_lang, zoom_pct)
                } else if view_mode == "compact" {
                    FileCompactGrid(left_entries, selected_name, current_lang, zoom_pct)
                } else {
                    FileDetailsTable("Main", left_entries, selected_name, current_lang)
                }
            },

            if show_inspector {
                row(padding = 0, gap = 0, w = 212, expand_h = true) [
                    divider(orientation = "vertical", size = 1, expand_h = true),
                    InspectorPanel(
                        selected_name,
                        selected_path,
                        selected_size,
                        selected_perms,
                        selected_cas,
                        preview_content,
                        current_lang
                    )
                ]
            } else {
                spacer(1)
            }
        ],

        // 4. Optional F4 Bottom Terminal Panel
        if show_terminal {
            column(padding = 0, gap = 0, expand = true) [
                divider(size = 1),
                TerminalPanel(current_path, terminal_history, terminal_input)
            ]
        } else {
            spacer(1)
        },

        // 5. Bottom Status Bar with Integrated Filter & Space Info
        BottomStatusBar(
            filter_query,
            dir_c + file_c,
            dir_c,
            file_c,
            selected_name,
            selected_size,
            current_lang,
            zoom_pct
        )
    ]
}
