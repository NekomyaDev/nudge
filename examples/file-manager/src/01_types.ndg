fn i18n(key: string, lang: string) -> string {
    let mut out = key
    if lang == "en" {
        out = tr_en(key)
    } else if lang == "tr" {
        out = tr_tr(key)
    } else if lang == "de" {
        out = tr_de(key)
    } else if lang == "fr" {
        out = tr_fr(key)
    } else if lang == "es" {
        out = tr_es(key)
    } else if lang == "ru" {
        out = tr_ru(key)
    } else if lang == "zh" {
        out = tr_zh(key)
    } else if lang == "ja" {
        out = tr_ja(key)
    } else if lang == "ko" {
        out = tr_ko(key)
    } else {
        out = tr_en(key)
    }
    out
}
