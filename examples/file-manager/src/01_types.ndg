fn i18n(key: string, lang: string) -> string {
    let mut out = key
    if lang == "en" {
        out = tr_en(key)
    } else if lang == "tr" {
        out = tr_tr(key)
    } else if lang == "de" {
        out = tr_de(key)
    } else if lang == "fr" {
        out = tr_fr(key)
    } else if lang == "es" {
        out = tr_es(key)
    } else {
        out = tr_en(key)
    }
    out
}
