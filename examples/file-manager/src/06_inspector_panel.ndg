// examples/file-manager/src/06_inspector_panel.ndg
// Information & Metadata Inspector Dock Panel (F11)

view InspectorPanel(
    selected_name: string,
    selected_path: string,
    selected_size: string,
    selected_perms: string,
    selected_cas: string,
    preview_content: string,
    current_lang: string
) -> View {
    column(padding = 4, gap = 2, w = 210, expand_h = true, bg = "sidebar") [
        text("ℹ " + i18n("information", current_lang) + " (F11)", bold = true),
        divider(size = 1),
        if selected_name != "" {
            column(padding = 2, gap = 2) [
                text("▪ " + selected_name, bold = true),
                text(i18n("lbl_path", current_lang) + " " + selected_path),
                text(i18n("lbl_size", current_lang) + " " + selected_size),
                text(i18n("lbl_perm", current_lang) + " " + selected_perms),
                row(padding = 0, gap = 2) [
                    text("CAS:"),
                    badge(selected_cas, status = "info")
                ],
                button("▸ " + i18n("act_open", current_lang), id = "btn_open_selected_dir", variant = "toolbar", h = 24, on_click = open_selected_directory),
                row(padding = 0, gap = 2) [
                    button("✎ " + i18n("ctx_rename", current_lang), id = "btn_start_rename", variant = "toolbar", h = 24, on_click = start_rename),
                    button(i18n("act_copy", current_lang), id = "btn_copy", variant = "toolbar", h = 24, on_click = copy_selected)
                ],
                row(padding = 0, gap = 4) [
                    button("Paste", id = "btn_paste", variant = "toolbar", h = 24, on_click = paste_clipboard),
                    button("✕ " + i18n("act_delete", current_lang), id = "btn_delete", variant = "toolbar", h = 24, on_click = delete_selected)
                ],
                divider(size = 1),
                text(i18n("information", current_lang) + ":", bold = true),
                if preview_content != "" {
                    code_block(preview_content, id = "inspector_preview")
                } else {
                    text("(" + i18n("folder", current_lang) + ")")
                }
            ]
        } else {
            column(padding = 2, gap = 2) [
                text(i18n("no_item", current_lang)),
                button("▸ " + i18n("act_open", current_lang), id = "btn_open_selected_dir", variant = "toolbar", h = 24, on_click = open_selected_directory)
            ]
        }
    ]
}
