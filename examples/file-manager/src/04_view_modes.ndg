// examples/file-manager/src/04_view_modes.ndg
// Three Desktop View Modes: Details Table, Icons Grid, Compact Grid

// ── View Mode 1: Details Table ──────────────────────────────────────

view FileDetailsTable(panel_title: string, entries: [FileEntry], selected_name: string, current_lang: string) -> View {
    let mut rows = []
    for item in entries {
        let is_sel = (item.name == selected_name)
        let type_label = if item.is_dir { "Folder" } else if item.extension != "" { str.upper(item.extension) + " File" } else { "File" }
        rows = rows + [
            row(padding = 1, gap = 2, expand = true) [
                button(
                    item.glyph + "  " + item.name,
                    id = "entry_" + item.name,
                    variant = "item",
                    align = "start",
                    expand = true,
                    h = 24,
                    selected = is_sel,
                    on_click = on_item_click
                ),
                button(item.size_str, id = "sz_" + item.name, variant = "flat", align = "end", w = 85, h = 24, on_click = on_item_click),
                button(type_label, id = "type_" + item.name, variant = "flat", align = "start", w = 95, h = 24, on_click = on_item_click),
                button(item.permissions, id = "perm_" + item.name, variant = "flat", align = "start", w = 95, h = 24, on_click = on_item_click)
            ]
        ]
    }

    column(padding = 2, gap = 2, expand = true, expand_h = true) [
        row(padding = 2, gap = 2, bg = "toolbar", expand = true) [
            button("  " + i18n("col_name", current_lang), id = "sort_name", variant = "flat", align = "start", expand = true, h = 22, on_click = sort_by_name),
            button(i18n("col_size", current_lang), id = "sort_size", variant = "flat", align = "end", w = 85, h = 22, on_click = sort_by_size),
            button("Type", id = "sort_type", variant = "flat", align = "start", w = 95, h = 22, on_click = sort_by_type),
            button(i18n("col_perm", current_lang), id = "sort_perms", variant = "flat", align = "start", w = 95, h = 22)
        ],
        divider(size = 1),
        scroll(rows, id = "file_table_scroll", expand = true, padding = 1, gap = 2)
    ]
}

// ── View Mode 2: Icons View (Grid of Cards) ─────────────────────────

view FileIconsGrid(entries: [FileEntry], selected_name: string, current_lang: string, zoom_pct: int, is_split: bool) -> View {
    let card_w = if zoom_pct <= 75 { 120 } else if zoom_pct >= 150 { 190 } else if zoom_pct >= 125 { 165 } else { 145 }
    let card_h = if zoom_pct <= 75 { 90 } else if zoom_pct >= 150 { 130 } else if zoom_pct >= 125 { 118 } else { 106 }
    let cols = if is_split {
        if zoom_pct <= 75 { 4 } else if zoom_pct >= 150 { 2 } else { 3 }
    } else {
        if zoom_pct <= 75 { 7 } else if zoom_pct >= 150 { 4 } else if zoom_pct >= 125 { 5 } else { 6 }
    }

    let mut grid_rows = []
    let mut current_row = []
    for item in entries {
        let is_sel = (item.name == selected_name)
        let sub_text = if item.is_dir { "" } else { item.size_str }
        let card_label = if sub_text == "" { item.name } else { item.name + "\n" + sub_text }
        let ftype = if item.is_dir { "folder" } else if item.extension == "png" or item.extension == "jpg" or item.extension == "jpeg" or item.extension == "svg" or item.extension == "webp" or item.extension == "gif" { "image" } else if item.extension == "mp4" or item.extension == "mkv" or item.extension == "webm" or item.extension == "avi" { "video" } else if item.extension == "mp3" or item.extension == "flac" or item.extension == "wav" or item.extension == "ogg" { "audio" } else if item.extension == "rs" or item.extension == "ndg" or item.extension == "py" or item.extension == "js" or item.extension == "ts" or item.extension == "c" or item.extension == "cpp" or item.extension == "h" or item.extension == "json" or item.extension == "toml" or item.extension == "yaml" or item.extension == "md" { "code" } else if item.extension == "zip" or item.extension == "tar" or item.extension == "gz" or item.extension == "7z" or item.extension == "xz" { "archive" } else { "file" }
        let card = button(
            card_label,
            id = "entry_" + item.name,
            variant = if item.is_dir { "folder_card" } else { "file_card" },
            file_type = ftype,
            ext = item.extension,
            path = item.path,
            w = card_w,
            h = card_h,
            selected = is_sel,
            on_click = on_item_click
        )
        current_row = current_row + [card]
        if len(current_row) == cols {
            grid_rows = grid_rows + [
                row(current_row, padding = 4, gap = 8, expand = true)
            ]
            current_row = []
        }
    }
    if len(current_row) > 0 {
        grid_rows = grid_rows + [
            row(current_row, padding = 4, gap = 8, expand = true)
        ]
    }

    column(padding = 2, gap = 2, expand = true, expand_h = true) [
        scroll(grid_rows, id = "file_icons_scroll", expand = true, padding = 4, gap = 6)
    ]
}

// ── View Mode 3: Compact View (Multi-column list) ────────────────────

view FileCompactGrid(entries: [FileEntry], selected_name: string, current_lang: string, zoom_pct: int, is_split: bool) -> View {
    let comp_w = if is_split { 180 } else if zoom_pct <= 75 { 160 } else if zoom_pct >= 125 { 240 } else { 200 }
    let comp_cols = if is_split { 2 } else if zoom_pct <= 75 { 6 } else if zoom_pct >= 125 { 4 } else { 5 }

    let mut compact_rows = []
    let mut current_row = []
    for item in entries {
        let is_sel = (item.name == selected_name)
        let icon_glyph = if item.is_dir { "▸" } else { item.glyph }
        let item_btn = button(
            icon_glyph + "  " + item.name,
            id = "entry_" + item.name,
            variant = "item",
            align = "start",
            w = comp_w,
            h = 24,
            selected = is_sel,
            on_click = on_item_click
        )
        current_row = current_row + [item_btn]
        if len(current_row) == comp_cols {
            compact_rows = compact_rows + [
                row(current_row, padding = 1, gap = 4, expand = true)
            ]
            current_row = []
        }
    }
    if len(current_row) > 0 {
        compact_rows = compact_rows + [
            row(current_row, padding = 1, gap = 4, expand = true)
        ]
    }

    column(padding = 2, gap = 2, expand = true, expand_h = true) [
        scroll(compact_rows, id = "file_compact_scroll", expand = true, padding = 2, gap = 2)
    ]
}
