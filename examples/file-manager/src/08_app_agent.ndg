// examples/file-manager/src/08_app_agent.ndg
// Master Desktop Application Agent & Window Orchestrator

agent FileManagerApp {
    state {
        current_path: string = "/home/neko"
        history_back: [string] = []
        history_forward: [string] = []

        tabs: [string] = ["/home/neko"]
        active_tab_idx: int = 0

        all_entries: [FileEntry] = []
        filtered_entries: [FileEntry] = []

        // Split view (F3) secondary panel state
        split_path: string = "/home/neko/Belgeler"
        split_entries: [FileEntry] = []
        is_split: bool = false

        // Inspector (F11) state (compact, toggleable)
        show_inspector: bool = false
        show_hidden: bool = false
        selected_name: string = ""
        selected_path: string = ""
        selected_size: string = ""
        selected_perms: string = ""
        selected_cas: string = ""
        preview_content: string = ""

        // View mode: "icons" (default) | "compact" | "details"
        view_mode: string = "icons"

        // Filter & Language
        filter_query: string = ""
        sort_asc: bool = true
        current_lang: string = "en"

        // Breadcrumb vs raw input mode
        edit_path_mode: bool = false

        // Clipboard & Undo
        clipboard_path: string = ""
        clipboard_name: string = ""
        clipboard_content: string = ""
        last_created_path: string = ""

        // Theme: "breeze-light" | "breeze-dark"
        current_theme: string = "breeze-light"

        // F4 Embedded Terminal Dock
        show_terminal: bool = false
        terminal_history: [string] = ["Nudge Terminal v1.0 — Ready. Type commands below."]
        terminal_input: string = ""

        // F2 Inline Rename
        rename_mode: bool = false
        rename_text: string = ""

        // Zoom Level: 75, 100, 125, 150
        zoom_pct: int = 100

        // Clipboard Cut mode
        clipboard_is_cut: bool = false

        // Sort Column: "name" | "size" | "type"
        sort_column: string = "name"
    }

    fn init_default_path() uses Workspace {
        if !workspace.exists(state.current_path) {
            state.current_path = "."
            state.tabs = ["."]
            state.split_path = "."
        }
    }

    fn reset_state() uses UI, Workspace, Store {
        state.current_path = "."
        state.tabs = ["."]
        state.active_tab_idx = 0
        state.filter_query = ""
        state.selected_name = ""
        state.selected_path = ""
        state.preview_content = ""
        state.sort_asc = true
        state.sort_column = "name"
        state.is_split = false
        state.show_inspector = true
        state.show_hidden = false
        state.edit_path_mode = false
        state.last_created_path = ""
        state.current_lang = "en"
        state.view_mode = "icons"
        state.zoom_pct = 100
        state.clipboard_is_cut = false
        FileManagerApp.refresh()
    }

    fn refresh() uses Workspace, Store {
        let mut updated_tabs: [string] = []
        for (t, idx) in state.tabs {
            if idx == state.active_tab_idx {
                updated_tabs = updated_tabs + [state.current_path]
            } else {
                updated_tabs = updated_tabs + [t]
            }
        }
        state.tabs = updated_tabs

        let loaded = VfsBridge.list_directory(state.current_path)
        state.all_entries = loaded
        state.filtered_entries = filter_entries(loaded, state.filter_query, state.show_hidden)

        if state.is_split {
            let target_split = if workspace.exists(state.split_path) { state.split_path } else { state.current_path }
            let split_loaded = VfsBridge.list_directory(target_split)
            state.split_entries = filter_entries(split_loaded, "", state.show_hidden)
        }
    }

    fn navigate_to(p: string) uses Workspace, Store {
        let norm = normalize_vfs_path(p)
        if norm != state.current_path {
            state.history_back = state.history_back + [state.current_path]
            state.history_forward = []
            state.current_path = norm

            // Update current tab path
            let mut updated_tabs: [string] = []
            for (t, idx) in state.tabs {
                if idx == state.active_tab_idx {
                    updated_tabs = updated_tabs + [norm]
                } else {
                    updated_tabs = updated_tabs + [t]
                }
            }
            state.tabs = updated_tabs

            state.selected_name = ""
            state.selected_path = ""
            state.preview_content = ""
            FileManagerApp.refresh()
        }
    }

    fn nav_back() uses UI, Workspace, Store {
        let count = len(state.history_back)
        if count > 0 {
            let prev = state.history_back[count - 1]
            let mut new_back: [string] = []
            for (item, idx) in state.history_back {
                if idx < count - 1 {
                    new_back = new_back + [item]
                }
            }
            state.history_forward = state.history_forward + [state.current_path]
            state.history_back = new_back
            state.current_path = prev
            FileManagerApp.refresh()
        }
    }

    fn nav_forward() uses UI, Workspace, Store {
        let count = len(state.history_forward)
        if count > 0 {
            let next_p = state.history_forward[count - 1]
            let mut new_fwd: [string] = []
            for (item, idx) in state.history_forward {
                if idx < count - 1 {
                    new_fwd = new_fwd + [item]
                }
            }
            state.history_back = state.history_back + [state.current_path]
            state.history_forward = new_fwd
            state.current_path = next_p
            FileManagerApp.refresh()
        }
    }

    fn nav_up() uses UI, Workspace, Store {
        let parent_p = parent_vfs_path(state.current_path)
        FileManagerApp.navigate_to(parent_p)
    }

    fn reload_current() uses UI, Workspace, Store {
        VfsBridge.invalidate(state.current_path)
        FileManagerApp.refresh()
    }

    fn nav_home() uses UI, Workspace, Store {
        let target = if workspace.exists("/home/neko") { "/home/neko" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_root() uses UI, Workspace, Store {
        let target = if workspace.exists("/") { "/" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_desktop() uses UI, Workspace, Store {
        let target = if workspace.exists("/home/neko/Masaüstü") { "/home/neko/Masaüstü" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_docs() uses UI, Workspace, Store {
        let target = if workspace.exists("/home/neko/Belgeler") { "/home/neko/Belgeler" } else { "docs" }
        FileManagerApp.navigate_to(target)
    }

    fn nav_downloads() uses UI, Workspace, Store {
        let target = if workspace.exists("/home/neko/İndirilenler") { "/home/neko/İndirilenler" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_music() uses UI, Workspace, Store {
        let target = if workspace.exists("/home/neko/Müzik") { "/home/neko/Müzik" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_pictures() uses UI, Workspace, Store {
        let target = if workspace.exists("/home/neko/Resimler") { "/home/neko/Resimler" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_videos() uses UI, Workspace, Store {
        let target = if workspace.exists("/home/neko/Videolar") { "/home/neko/Videolar" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_trash() uses UI, Workspace, Store {
        let target = if workspace.exists("/home/neko/.local/share/Trash") { "/home/neko/.local/share/Trash" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn nav_nvfs() uses UI, Workspace, Store {
        let target = if workspace.exists("/tmp") { "/tmp" } else { "." }
        FileManagerApp.navigate_to(target)
    }

    fn on_tab_click(clicked_id: string) uses UI, Workspace, Store {
        let idx_str = str.replace(clicked_id, "tab_sel_", "")
        let target_idx = if idx_str == "0" {
            0
        } else if idx_str == "1" {
            1
        } else if idx_str == "2" {
            2
        } else if idx_str == "3" {
            3
        } else {
            0
        }
        let total = len(state.tabs)
        if target_idx < total {
            state.active_tab_idx = target_idx
            state.current_path = state.tabs[target_idx]
            FileManagerApp.refresh()
        }
    }

    fn on_tab_close(clicked_id: string) uses UI, Workspace, Store {
        let idx_str = str.replace(clicked_id, "tab_close_", "")
        let target_idx = if idx_str == "0" {
            0
        } else if idx_str == "1" {
            1
        } else if idx_str == "2" {
            2
        } else if idx_str == "3" {
            3
        } else {
            0
        }
        let total = len(state.tabs)
        if total > 1 {
            let mut new_tabs: [string] = []
            for (t, idx) in state.tabs {
                if idx != target_idx {
                    new_tabs = new_tabs + [t]
                }
            }
            state.tabs = new_tabs
            let new_total = len(new_tabs)
            state.active_tab_idx = if state.active_tab_idx >= new_total { new_total - 1 } else { state.active_tab_idx }
            state.current_path = state.tabs[state.active_tab_idx]
            FileManagerApp.refresh()
        }
    }

    fn on_new_tab() uses UI, Workspace, Store {
        state.tabs = state.tabs + [state.current_path]
        state.active_tab_idx = len(state.tabs) - 1
        FileManagerApp.refresh()
    }

    fn on_crumb_click(clicked_id: string) uses UI, Workspace, Store {
        let target_p = str.replace(clicked_id, "crumb_", "")
        if workspace.exists(target_p) {
            FileManagerApp.navigate_to(target_p)
        }
    }

    fn on_item_click(clicked_id: string) uses UI, Workspace, Store {
        let mut clean_name = str.replace(clicked_id, "entry_", "")
        clean_name = str.replace(clean_name, "sz_", "")
        clean_name = str.replace(clean_name, "perm_", "")

        let mut matched_entry: FileEntry = {
            name: "", path: "", is_dir: false, size_bytes: 0, size_str: "",
            mtime_ms: 0, permissions: "", extension: "", glyph: "", cas_hash: ""
        }
        let mut found = false
        for e in state.filtered_entries {
            if e.name == clean_name {
                matched_entry = e
                found = true
            }
        }

        if found {
            if matched_entry.is_dir {
                // Instantly navigate into folder on click
                FileManagerApp.navigate_to(matched_entry.path)
            } else {
                state.selected_name = matched_entry.name
                state.selected_path = matched_entry.path
                state.selected_size = matched_entry.size_str
                state.selected_perms = matched_entry.permissions
                state.selected_cas = compute_cas_hash(matched_entry.path)
                state.preview_content = workspace.read(matched_entry.path)
            }
        }
    }

    fn set_view_icons() uses UI {
        state.view_mode = "icons"
    }

    fn set_view_compact() uses UI {
        state.view_mode = "compact"
    }

    fn set_view_details() uses UI {
        state.view_mode = "details"
    }

    fn toggle_split() uses UI, Workspace, Store {
        state.is_split = !state.is_split
        if state.is_split {
            let target_split = if workspace.exists(state.split_path) { state.split_path } else { state.current_path }
            let split_loaded = VfsBridge.list_directory(target_split)
            state.split_entries = split_loaded
        }
    }

    fn toggle_inspector() uses UI {
        state.show_inspector = !state.show_inspector
    }

    fn toggle_hidden_files() uses UI, Workspace {
        state.show_hidden = !state.show_hidden
        FileManagerApp.refresh()
    }

    fn toggle_theme() uses UI {
        if state.current_theme == "breeze-light" {
            state.current_theme = "breeze-dark"
        } else {
            state.current_theme = "breeze-light"
        }
    }

    fn toggle_lang() uses UI {
        if state.current_lang == "en" {
            state.current_lang = "tr"
        } else if state.current_lang == "tr" {
            state.current_lang = "de"
        } else if state.current_lang == "de" {
            state.current_lang = "fr"
        } else if state.current_lang == "fr" {
            state.current_lang = "es"
        } else if state.current_lang == "es" {
            state.current_lang = "ru"
        } else if state.current_lang == "ru" {
            state.current_lang = "zh"
        } else if state.current_lang == "zh" {
            state.current_lang = "ja"
        } else if state.current_lang == "ja" {
            state.current_lang = "ko"
        } else {
            state.current_lang = "en"
        }
    }

    fn toggle_path_edit() uses UI {
        state.edit_path_mode = !state.edit_path_mode
    }

    fn on_path_input_change(new_val: string) uses UI, Workspace, Store {
        state.current_path = new_val
        FileManagerApp.refresh()
    }

    fn toggle_sort() uses UI {
        state.sort_asc = !state.sort_asc
    }

    fn on_filter_change(query: string) uses UI {
        state.filter_query = query
        state.filtered_entries = filter_entries(state.all_entries, query, state.show_hidden)
    }

    fn clear_filter() uses UI {
        state.filter_query = ""
        state.filtered_entries = filter_entries(state.all_entries, "", state.show_hidden)
    }

    fn select_or_open_entry() uses UI, Workspace {
        if len(state.filtered_entries) > 0 {
            let first = state.filtered_entries[0]
            state.selected_name = first.name
            state.selected_path = first.path
            state.selected_size = first.size_str
            state.selected_perms = first.permissions
            state.selected_cas = compute_cas_hash(first.path)
            if !first.is_dir {
                state.preview_content = workspace.read(first.path)
            } else {
                state.preview_content = ""
            }
        }
    }

    fn copy_selected() uses UI, Workspace {
        if state.selected_path != "" {
            state.clipboard_path = state.selected_path
            state.clipboard_name = state.selected_name
            state.clipboard_is_cut = false
            let entries = state.filtered_entries
            let mut is_d = false
            for e in entries {
                if e.name == state.selected_name {
                    is_d = e.is_dir
                }
            }
            if !is_d {
                state.clipboard_content = workspace.read(state.selected_path)
            } else {
                state.clipboard_content = ""
            }
        }
    }

    fn cut_selected() uses UI, Workspace {
        FileManagerApp.copy_selected()
        state.clipboard_is_cut = true
    }

    fn paste_clipboard() uses UI, Workspace, WorkspaceDelete, Store {
        if state.clipboard_path != "" {
            let dest_name = if state.clipboard_is_cut { state.clipboard_name } else { "copy_of_" + state.clipboard_name }
            let dest_path = if state.current_path == "." {
                dest_name
            } else if state.current_path == "/" {
                "/" + dest_name
            } else {
                state.current_path + "/" + dest_name
            }
            workspace.write(dest_path, state.clipboard_content)
            if state.clipboard_is_cut {
                workspace.delete(state.clipboard_path, recursive = true)
                state.clipboard_is_cut = false
                state.clipboard_path = ""
                state.clipboard_name = ""
                state.clipboard_content = ""
            }
            VfsBridge.invalidate(state.current_path)
            FileManagerApp.refresh()
        }
    }

    fn zoom_in() uses UI {
        if state.zoom_pct < 150 {
            state.zoom_pct = state.zoom_pct + 25
        }
    }

    fn zoom_out() uses UI {
        if state.zoom_pct > 75 {
            state.zoom_pct = state.zoom_pct - 25
        }
    }

    fn sort_by_name() uses UI {
        if state.sort_column == "name" {
            state.sort_asc = !state.sort_asc
        } else {
            state.sort_column = "name"
            state.sort_asc = true
        }
        FileManagerApp.apply_sorting()
    }

    fn sort_by_size() uses UI {
        if state.sort_column == "size" {
            state.sort_asc = !state.sort_asc
        } else {
            state.sort_column = "size"
            state.sort_asc = true
        }
        FileManagerApp.apply_sorting()
    }

    fn sort_by_type() uses UI {
        if state.sort_column == "type" {
            state.sort_asc = !state.sort_asc
        } else {
            state.sort_column = "type"
            state.sort_asc = true
        }
        FileManagerApp.apply_sorting()
    }

    fn apply_sorting() uses UI {
        let entries = state.filtered_entries
        let mut dirs: [FileEntry] = []
        let mut files: [FileEntry] = []
        for e in entries {
            if e.is_dir {
                dirs = dirs + [e]
            } else {
                files = files + [e]
            }
        }
        if !state.sort_asc {
            let mut rev_f: [FileEntry] = []
            for e in files {
                rev_f = [e] + rev_f
            }
            files = rev_f
            let mut rev_d: [FileEntry] = []
            for d in dirs {
                rev_d = [d] + rev_d
            }
            dirs = rev_d
        }
        state.filtered_entries = dirs + files
    }

    fn create_new_folder() uses UI, Workspace, Store {
        let keep_file = if state.current_path == "." {
            "New_Folder/.keep"
        } else if state.current_path == "/" {
            "/New_Folder/.keep"
        } else {
            state.current_path + "/New_Folder/.keep"
        }
        workspace.write(keep_file, "")
        let folder_only = if state.current_path == "." {
            "New_Folder"
        } else if state.current_path == "/" {
            "/New_Folder"
        } else {
            state.current_path + "/New_Folder"
        }
        state.last_created_path = folder_only
        VfsBridge.invalidate(state.current_path)
        FileManagerApp.refresh()
    }

    fn undo_last_action() uses UI, Workspace, WorkspaceDelete, Store {
        if state.last_created_path != "" {
            workspace.delete(state.last_created_path, recursive = true)
            state.last_created_path = ""
            VfsBridge.invalidate(state.current_path)
            FileManagerApp.refresh()
        }
    }

    fn open_selected_directory() uses UI, Workspace, Store {
        if state.selected_path != "" {
            let mut is_d = false
            for e in state.filtered_entries {
                if e.path == state.selected_path {
                    is_d = e.is_dir
                }
            }
            if is_d {
                FileManagerApp.navigate_to(state.selected_path)
            }
        }
    }

    fn delete_selected() uses UI, Workspace, WorkspaceDelete, Store {
        if state.selected_path != "" {
            workspace.delete(state.selected_path, recursive = true)
            state.selected_name = ""
            state.selected_path = ""
            state.selected_size = ""
            state.selected_perms = ""
            state.selected_cas = ""
            state.preview_content = ""
            VfsBridge.invalidate(state.current_path)
            FileManagerApp.refresh()
        }
    }

    fn toggle_terminal() uses UI {
        state.show_terminal = !state.show_terminal
    }

    fn on_terminal_input_change(v: string) uses UI {
        state.terminal_input = v
    }

    fn on_terminal_submit() uses UI, Workspace, Store {
        let cmd = str.trim(state.terminal_input)
        if cmd != "" {
            let prompt_line = "$ " + cmd
            let mut out_line = ""
            if cmd == "pwd" {
                out_line = state.current_path
            } else if cmd == "ls" {
                out_line = "Listed " + str.to_string(len(state.filtered_entries)) + " items in " + state.current_path
            } else if cmd == "clear" {
                state.terminal_history = ["Terminal cleared."]
                state.terminal_input = ""
            } else if str.starts_with(cmd, "cd ") {
                let p = str.trim(str.replace(cmd, "cd ", ""))
                FileManagerApp.navigate_to(p)
                out_line = "Changed directory to " + p
            } else if str.starts_with(cmd, "mkdir ") {
                let dir_name = str.trim(str.replace(cmd, "mkdir ", ""))
                let full = state.current_path + "/" + dir_name + "/.keep"
                workspace.write(full, "")
                VfsBridge.invalidate(state.current_path)
                FileManagerApp.refresh()
                out_line = "Created folder " + dir_name
            } else {
                out_line = "Executed: " + cmd
            }
            if cmd != "clear" {
                state.terminal_history = state.terminal_history + [prompt_line, out_line]
                state.terminal_input = ""
            }
        }
    }

    fn start_rename() uses UI {
        if state.selected_name != "" {
            state.rename_mode = true
            state.rename_text = state.selected_name
        }
    }

    fn on_rename_text_change(v: string) uses UI {
        state.rename_text = v
    }

    fn confirm_rename() uses UI, Workspace, WorkspaceDelete, Store {
        if state.rename_mode and state.rename_text != "" and state.selected_path != "" {
            let parent_p = parent_vfs_path(state.selected_path)
            let new_p = if parent_p == "/" { "/" + state.rename_text } else { parent_p + "/" + state.rename_text }
            let old_content = workspace.read(state.selected_path)
            workspace.write(new_p, old_content)
            workspace.delete(state.selected_path, recursive = true)
            state.rename_mode = false
            state.selected_name = state.rename_text
            state.selected_path = new_p
            VfsBridge.invalidate(state.current_path)
            FileManagerApp.refresh()
        }
    }

    fn cancel_rename() uses UI {
        state.rename_mode = false
    }

    fn on_key(k: string) uses UI, Workspace, WorkspaceDelete, Store {
        if k == "F2" {
            FileManagerApp.start_rename()
        } else if k == "F3" {
            FileManagerApp.toggle_split()
        } else if k == "F4" {
            FileManagerApp.toggle_terminal()
        } else if k == "F5" {
            FileManagerApp.reload_current()
        } else if k == "F11" {
            FileManagerApp.toggle_inspector()
        } else if k == "Delete" {
            FileManagerApp.delete_selected()
        } else if k == "Escape" {
            if state.rename_mode {
                FileManagerApp.cancel_rename()
            }
        } else if k == "Enter" {
            FileManagerApp.open_selected_directory()
        } else if k == "Backspace" {
            FileManagerApp.nav_up()
        } else if k == "Ctrl++" or k == "Ctrl+=" {
            FileManagerApp.zoom_in()
        } else if k == "Ctrl+-" {
            FileManagerApp.zoom_out()
        } else if k == "Ctrl+0" {
            state.zoom_pct = 100
        } else if k == "Ctrl+a" or k == "Ctrl+A" {
            FileManagerApp.select_or_open_entry()
        } else if k == "Ctrl+h" or k == "Ctrl+H" {
            FileManagerApp.toggle_hidden_files()
        } else if k == "Ctrl+t" or k == "Ctrl+T" {
            FileManagerApp.on_new_tab()
        } else if k == "Ctrl+w" or k == "Ctrl+W" {
            let active_str = str.to_string(state.active_tab_idx)
            FileManagerApp.on_tab_close("tab_close_" + active_str)
        } else if k == "Ctrl+l" or k == "Ctrl+L" {
            FileManagerApp.toggle_path_edit()
        } else if str.starts_with(k, "ContextMenu:") {
            let parts = str.split(k, ":")
            let p_len = len(parts)
            if p_len >= 3 {
                let act = parts[1]
                let target = parts[2]
                if target != "window" {
                    let mut clean_target = str.replace(target, "entry_", "")
                    clean_target = str.replace(clean_target, "sz_", "")
                    clean_target = str.replace(clean_target, "perm_", "")
                    for e in state.filtered_entries {
                        if e.name == clean_target {
                            state.selected_name = e.name
                            state.selected_path = e.path
                            state.selected_size = e.size_str
                            state.selected_perms = e.permissions
                            state.selected_cas = compute_cas_hash(e.path)
                            state.preview_content = if e.is_dir { "" } else { workspace.read(e.path) }
                        }
                    }
                }

                if act == "open" {
                    FileManagerApp.open_selected_directory()
                } else if act == "cut" {
                    FileManagerApp.cut_selected()
                } else if act == "copy" {
                    FileManagerApp.copy_selected()
                } else if act == "paste" {
                    FileManagerApp.paste_clipboard()
                } else if act == "rename" {
                    FileManagerApp.start_rename()
                } else if act == "delete" {
                    FileManagerApp.delete_selected()
                } else if act == "properties" {
                    state.show_inspector = true
                } else if act == "new_folder" {
                    FileManagerApp.create_new_folder()
                } else if act == "open_terminal" {
                    state.show_terminal = true
                } else if act == "reload" {
                    FileManagerApp.reload_current()
                }
            }
        }
    }

    window MainWindow {
        title: "Nudge Files",
        width: 1240,
        height: 720,
        theme: state.current_theme,
        content: FileManagerLayout(
            state.current_path,
            state.filtered_entries,
            state.split_entries,
            state.selected_name,
            state.selected_path,
            state.selected_size,
            state.selected_perms,
            state.selected_cas,
            state.preview_content,
            state.filter_query,
            state.is_split,
            state.show_inspector,
            state.show_hidden,
            state.edit_path_mode,
            state.current_theme,
            state.current_lang,
            state.view_mode,
            state.tabs,
            state.active_tab_idx,
            state.show_terminal,
            state.terminal_history,
            state.terminal_input,
            state.zoom_pct
        )
    }
}

fn main() uses UI, Workspace {
    FileManagerApp.init_default_path()
    FileManagerApp.refresh()
    FileManagerApp.MainWindow.open()
}
