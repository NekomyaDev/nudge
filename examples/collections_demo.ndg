// Pure Nudge Map and List Native Primitives Acceptance Suite
// Testing map.has, map.get, map.keys, map.values, map.remove, map.set,
// map.len, map.merge, map.entries, list.contains, list.index_of, list.slice,
// list.reverse, list.sort, list.unique, list.first, list.last, list.push, list.concat, list.flatten

test "map primitives insertion lookup keys and deletion" {
    let mut m: Map[string, int] = {}
    m["cpu"] = 8
    m["ram"] = 32
    m["storage"] = 1000

    assert map.has(m, "cpu")
    assert map.has(m, "ram")
    assert !map.has(m, "gpu")

    assert map.get(m, "cpu", 0) == 8
    assert map.get(m, "gpu", 999) == 999
    assert map.len(m) == 3

    let keys = map.keys(m)
    assert len(keys) == 3
    assert keys[0] == "cpu"
    assert keys[1] == "ram"
    assert keys[2] == "storage"

    let vals = map.values(m)
    assert len(vals) == 3
    assert vals[0] == 8
    assert vals[1] == 32
    assert vals[2] == 1000

    let m_no_ram = map.remove(m, "ram")
    assert !map.has(m_no_ram, "ram")
    assert map.has(m_no_ram, "cpu")
    assert len(map.keys(m_no_ram)) == 2

    let m_with_gpu = map.set(m_no_ram, "gpu", 16)
    assert map.has(m_with_gpu, "gpu")
    assert map.get(m_with_gpu, "gpu", 0) == 16
}

test "list primitives search slice and reverse" {
    let xs = ["red", "green", "blue", "yellow"]

    assert list.contains(xs, "green")
    assert !list.contains(xs, "purple")

    assert list.index_of(xs, "blue") == 2
    assert list.index_of(xs, "black") == -1

    let middle = list.slice(xs, 1, 3)
    assert len(middle) == 2
    assert middle[0] == "green"
    assert middle[1] == "blue"

    let rev = list.reverse(xs)
    assert len(rev) == 4
    assert rev[0] == "yellow"
    assert rev[1] == "blue"
    assert rev[2] == "green"
    assert rev[3] == "red"

    let nums = [40, 10, 30, 20]
    let sorted_nums = list.sort(nums)
    assert sorted_nums[0] == 10
    assert sorted_nums[3] == 40

    let duplicates = [1, 2, 2, 3, 1, 4]
    let uniq = list.unique(duplicates)
    assert len(uniq) == 4

    assert list.first(nums) == 40
    assert list.last(nums) == 20

    let appended = list.push(nums, 50)
    assert len(appended) == 5
    assert list.last(appended) == 50

    let combined = list.concat([1, 2], [3, 4])
    assert len(combined) == 4
    assert combined[2] == 3
}

fn main() -> int {
    let mut m: Map[string, string] = {}
    m["greeting"] = "hello"
    m["target"] = "world"

    if map.has(m, "greeting") and map.get(m, "target", "") == "world" {
        0
    } else {
        1
    }
}
