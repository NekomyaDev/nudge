// Pure .ndg Box Model & Text Layout Engine
// Part of Phase F7.1 (docs/browser-roadmap.md)

type BoxStyle = {
    display: string,
    width: int,
    height: int,
    margin_top: int,
    margin_bottom: int,
    margin_left: int,
    margin_right: int,
    padding: int,
    gap: int
}

type ContainerCursor = {
    ref: int,
    is_flex: bool,
    cur_x: int,
    cur_y: int,
    gap: int,
    padding: int
}

type LayoutBox = {
    ref: int,
    tag: string,
    role: string,
    name: string,
    x: int,
    y: int,
    w: int,
    h: int,
    display: string
}

type LayoutTree = {
    boxes: [LayoutBox],
    viewport_width: int,
    viewport_height: int
}

fn parse_css_px_val(s: string, key: string, fallback: int) -> int {
    let pos = str.index_of(s, key)
    let mut out = fallback
    if pos >= 0 {
        let after_key = pos + str.length(key)
        let colon = str.index_of(str.substring(s, after_key), ":")
        if colon >= 0 {
            let start = after_key + colon + 1
            let semi = str.index_of(str.substring(s, start), ";")
            let val_part = if semi >= 0 {
                str.substring(s, start, start + semi)
            } else {
                str.substring(s, start)
            }
            let trimmed = str.trim(val_part)
            let px_pos = str.index_of(trimmed, "px")
            let num_str = if px_pos >= 0 {
                str.substring(trimmed, 0, px_pos)
            } else {
                trimmed
            }
            let parsed = str.to_int(num_str)
            if parsed != 0 or num_str == "0" {
                out = parsed
            }
        }
    }
    out
}

fn compute_node_style(tag: string, style_attr: string) -> BoxStyle {
    let is_block_tag = (tag == "div" or tag == "p" or tag == "h1" or tag == "h2" or tag == "h3" or tag == "form" or tag == "section" or tag == "header" or tag == "footer" or tag == "ul" or tag == "ol" or tag == "li")
    let default_display = if is_block_tag { "block" } else { "inline" }

    let mut display = default_display
    if str.contains(style_attr, "display: none") or str.contains(style_attr, "display:none") {
        display = "none"
    } else if str.contains(style_attr, "display: flex") or str.contains(style_attr, "display:flex") {
        display = "flex"
    } else if str.contains(style_attr, "display: inline-block") or str.contains(style_attr, "display:inline-block") {
        display = "inline-block"
    } else if str.contains(style_attr, "display: block") or str.contains(style_attr, "display:block") {
        display = "block"
    } else if str.contains(style_attr, "display: inline") or str.contains(style_attr, "display:inline") {
        display = "inline"
    }

    let def_w = if is_block_tag { -1 } else if tag == "button" { 80 } else if tag == "input" { 160 } else { 0 }
    let def_h = if tag == "h1" { 36 } else if tag == "h2" { 30 } else if tag == "button" { 28 } else if tag == "input" { 26 } else if is_block_tag { -1 } else { 18 }

    let w = parse_css_px_val(style_attr, "width", def_w)
    let h = parse_css_px_val(style_attr, "height", def_h)
    let m = parse_css_px_val(style_attr, "margin", 0)
    let p = parse_css_px_val(style_attr, "padding", 0)
    let g = parse_css_px_val(style_attr, "gap", 0)

    let mt = parse_css_px_val(style_attr, "margin-top", m)
    let mb = parse_css_px_val(style_attr, "margin-bottom", m)
    let ml = parse_css_px_val(style_attr, "margin-left", m)
    let mr = parse_css_px_val(style_attr, "margin-right", m)

    {
        display: display,
        width: w,
        height: h,
        margin_top: mt,
        margin_bottom: mb,
        margin_left: ml,
        margin_right: mr,
        padding: p,
        gap: g
    }
}

fn compute_layout(tree: DomTree, viewport_w: int, viewport_h: int) -> LayoutTree {
    let mut boxes: [LayoutBox] = []
    let mut top_x = 0
    let mut top_y = 0
    let line_height = 20
    let mut cursors: [ContainerCursor] = []

    for n in tree.nodes {
        let style_attr = get_attr_value(n.attrs, "style", "")
        let style = compute_node_style(n.tag, style_attr)

        if style.display == "none" {
            boxes = boxes + [{
                ref: n.ref,
                tag: n.tag,
                role: n.role,
                name: n.name,
                x: 0,
                y: 0,
                w: 0,
                h: 0,
                display: "none"
            }]
        } else {
            // Find parent container cursor if nested
            let mut parent_idx = -1
            let mut c_idx = 0
            for c in cursors {
                if c.ref == n.parent {
                    parent_idx = c_idx
                }
                c_idx = c_idx + 1
            }

            let is_block_like = (style.display == "block" or style.display == "flex")
            let def_box_w = if is_block_like {
                if parent_idx >= 0 {
                    // Fit within parent container
                    viewport_w - style.margin_left - style.margin_right
                } else {
                    viewport_w - top_x - style.margin_left - style.margin_right
                }
            } else if n.tag == "button" {
                80
            } else if n.tag == "input" {
                160
            } else if n.text != "" {
                str.length(n.text) * 8 + 10
            } else {
                30
            }

            let box_w = if style.width > 0 { style.width } else { def_box_w }

            // Multi-line text height calculation
            let text_len = str.length(n.text)
            let max_line_chars = if box_w > 16 { (box_w - 16) / 8 } else { 10 }
            let line_count = if text_len == 0 { 0 } else { (text_len / max_line_chars) + 1 }
            let text_extra = if line_count > 0 { line_count * 18 } else { 0 }
            let box_h = if style.height > 0 {
                style.height
            } else if is_block_like {
                if text_extra > 0 { text_extra } else { 24 }
            } else {
                24
            }

            let mut box_x = 0
            let mut box_y = 0

            if parent_idx >= 0 {
                let p_cur = cursors[parent_idx]
                if p_cur.is_flex {
                    box_x = p_cur.cur_x + style.margin_left
                    box_y = p_cur.cur_y + style.margin_top
                    let next_cx = box_x + box_w + style.margin_right + p_cur.gap
                    cursors[parent_idx] = {
                        ref: p_cur.ref,
                        is_flex: true,
                        cur_x: next_cx,
                        cur_y: p_cur.cur_y,
                        gap: p_cur.gap,
                        padding: p_cur.padding
                    }
                } else {
                    box_x = p_cur.cur_x + style.margin_left
                    box_y = p_cur.cur_y + style.margin_top
                    let next_cy = box_y + box_h + style.margin_bottom
                    cursors[parent_idx] = {
                        ref: p_cur.ref,
                        is_flex: false,
                        cur_x: p_cur.cur_x,
                        cur_y: next_cy,
                        gap: p_cur.gap,
                        padding: p_cur.padding
                    }
                }
            } else {
                // Top-level element
                if is_block_like {
                    if top_x > 0 {
                        top_x = 0
                        top_y = top_y + line_height
                    }
                    top_y = top_y + style.margin_top
                    box_x = top_x + style.margin_left
                    box_y = top_y
                    top_y = box_y + box_h + style.margin_bottom
                    top_x = 0
                } else {
                    if top_x + box_w > viewport_w and top_x > 0 {
                        top_x = 0
                        top_y = top_y + line_height + 4
                    }
                    box_x = top_x + style.margin_left
                    box_y = top_y + style.margin_top
                    top_x = box_x + box_w + style.margin_right
                }
            }

            if is_block_like {
                cursors = cursors + [{
                    ref: n.ref,
                    is_flex: (style.display == "flex"),
                    cur_x: box_x + style.padding,
                    cur_y: box_y + style.padding,
                    gap: style.gap,
                    padding: style.padding
                }]
            }

            boxes = boxes + [{
                ref: n.ref,
                tag: n.tag,
                role: n.role,
                name: n.name,
                x: box_x,
                y: box_y,
                w: box_w,
                h: box_h,
                display: style.display
            }]
        }
    }

    {
        boxes: boxes,
        viewport_width: viewport_w,
        viewport_height: viewport_h
    }
}

fn get_box_bounds(lt: LayoutTree, target_ref: int) -> [int] {
    let mut res = [0, 0, 0, 0]
    for b in lt.boxes {
        if b.ref == target_ref {
            res = [b.x, b.y, b.w, b.h]
        }
    }
    res
}

fn apply_layout_to_snapshot(snap: Snapshot, lt: LayoutTree) -> Snapshot {
    let mut updated_elements: [Element] = []
    for el in snap.elements {
        let b = get_box_bounds(lt, el.ref)
        updated_elements = updated_elements + [{
            index: el.index,
            ref: el.ref,
            role: el.role,
            title: el.title,
            name: el.name,
            value: el.value,
            tag: el.tag,
            href: el.href,
            pressable: el.pressable,
            clickable: el.clickable,
            editable: el.editable,
            focused: el.focused,
            enabled: el.enabled,
            actions: el.actions,
            bounds: b
        }]
    }

    {
        page: snap.page,
        url: snap.url,
        title: snap.title,
        state_id: snap.state_id,
        elements: updated_elements,
        tree: snap.tree,
        count: snap.count,
        screenshot: snap.screenshot,
        drift: snap.drift
    }
}
