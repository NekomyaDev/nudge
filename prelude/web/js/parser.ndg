// Pure .ndg JavaScript AST Parser (ES Subset)
// Part of Phase F6.1 (docs/browser-roadmap.md)

type JsNode = {
    id: int,
    kind: string,
    str_val: string,
    num_val: float,
    bool_val: bool,
    op: string,
    left: int,
    right: int,
    extra: int,
    children: [int],
    args: [string]
}

type JsAst = {
    nodes: [JsNode],
    root_id: int
}

fn empty_node(id: int, kind: string) -> JsNode {
    {
        id: id,
        kind: kind,
        str_val: "",
        num_val: 0.0,
        bool_val: false,
        op: "",
        left: -1,
        right: -1,
        extra: -1,
        children: [],
        args: []
    }
}

fn parse_js_script(tokens: [JsToken]) -> JsAst {
    let mut nodes: [JsNode] = []
    let mut next_id = 1
    let mut i = 0
    let n = len(tokens)
    let mut top_stmts: [int] = []

    for _ in tokens {
        if i < n {
            let tok = tokens[i]
            if tok.kind == "keyword" and (tok.val == "var" or tok.val == "let" or tok.val == "const") {
                // Variable declaration: var x = 10;
                i = i + 1
                if i < n and tokens[i].kind == "ident" {
                    let var_name = tokens[i].val
                    i = i + 1
                    let mut init_id = -1
                    if i < n and tokens[i].val == "=" {
                        i = i + 1
                        if i < n {
                            let val_tok = tokens[i]
                            let val_id = next_id
                            next_id = next_id + 1
                            if val_tok.kind == "number" {
                                let mut num_node = empty_node(val_id, "lit_num")
                                num_node = {
                                    id: num_node.id,
                                    kind: num_node.kind,
                                    str_val: num_node.str_val,
                                    num_val: str.to_float(val_tok.val),
                                    bool_val: num_node.bool_val,
                                    op: num_node.op,
                                    left: num_node.left,
                                    right: num_node.right,
                                    extra: num_node.extra,
                                    children: num_node.children,
                                    args: num_node.args
                                }
                                nodes = nodes + [num_node]
                            } else if val_tok.kind == "string" {
                                let mut str_node = empty_node(val_id, "lit_str")
                                str_node = {
                                    id: str_node.id,
                                    kind: str_node.kind,
                                    str_val: val_tok.val,
                                    num_val: str_node.num_val,
                                    bool_val: str_node.bool_val,
                                    op: str_node.op,
                                    left: str_node.left,
                                    right: str_node.right,
                                    extra: str_node.extra,
                                    children: str_node.children,
                                    args: str_node.args
                                }
                                nodes = nodes + [str_node]
                            } else if val_tok.val == "true" or val_tok.val == "false" {
                                let mut bool_node = empty_node(val_id, "lit_bool")
                                bool_node = {
                                    id: bool_node.id,
                                    kind: bool_node.kind,
                                    str_val: bool_node.str_val,
                                    num_val: bool_node.num_val,
                                    bool_val: (val_tok.val == "true"),
                                    op: bool_node.op,
                                    left: bool_node.left,
                                    right: bool_node.right,
                                    extra: bool_node.extra,
                                    children: bool_node.children,
                                    args: bool_node.args
                                }
                                nodes = nodes + [bool_node]
                            }
                            init_id = val_id
                            i = i + 1
                        }
                    }
                    if i < n and tokens[i].val == ";" {
                        i = i + 1
                    }

                    let decl_id = next_id
                    next_id = next_id + 1
                    let mut decl_node = empty_node(decl_id, "var_decl")
                    decl_node = {
                        id: decl_node.id,
                        kind: decl_node.kind,
                        str_val: var_name,
                        num_val: decl_node.num_val,
                        bool_val: decl_node.bool_val,
                        op: decl_node.op,
                        left: init_id,
                        right: decl_node.right,
                        extra: decl_node.extra,
                        children: decl_node.children,
                        args: decl_node.args
                    }
                    nodes = nodes + [decl_node]
                    top_stmts = top_stmts + [decl_id]
                }
            } else if tok.kind == "keyword" and tok.val == "function" {
                // Function declaration: function foo(a, b) { ... }
                i = i + 1
                let mut fn_name = "anonymous"
                if i < n and tokens[i].kind == "ident" {
                    fn_name = tokens[i].val
                    i = i + 1
                }
                let mut params: [string] = []
                if i < n and tokens[i].val == "(" {
                    i = i + 1
                    let mut p_done = false
                    for _ in tokens {
                        if i < n and !p_done {
                            if tokens[i].val == ")" {
                                p_done = true
                                i = i + 1
                            } else if tokens[i].kind == "ident" {
                                params = params + [tokens[i].val]
                                i = i + 1
                            } else if tokens[i].val == "," {
                                i = i + 1
                            } else {
                                i = i + 1
                            }
                        }
                    }
                }
                // Skip to closing brace
                if i < n and tokens[i].val == "{" {
                    let mut depth = 1
                    i = i + 1
                    for _ in tokens {
                        if i < n and depth > 0 {
                            if tokens[i].val == "{" {
                                depth = depth + 1
                            } else if tokens[i].val == "}" {
                                depth = depth - 1
                            }
                            i = i + 1
                        }
                    }
                }
                let fn_id = next_id
                next_id = next_id + 1
                let mut fn_node = empty_node(fn_id, "func")
                fn_node = {
                    id: fn_node.id,
                    kind: fn_node.kind,
                    str_val: fn_name,
                    num_val: fn_node.num_val,
                    bool_val: fn_node.bool_val,
                    op: fn_node.op,
                    left: -1,
                    right: -1,
                    extra: -1,
                    children: [],
                    args: params
                }
                nodes = nodes + [fn_node]
                top_stmts = top_stmts + [fn_id]
            } else if tok.kind == "keyword" and tok.val == "return" {
                i = i + 1
                let ret_id = next_id
                next_id = next_id + 1
                let ret_node = empty_node(ret_id, "return")
                nodes = nodes + [ret_node]
                top_stmts = top_stmts + [ret_id]
                if i < n and tokens[i].val == ";" {
                    i = i + 1
                }
            } else if tok.kind == "keyword" and tok.val == "while" {
                // while (cond) { body }
                i = i + 1
                if i < n and tokens[i].val == "(" {
                    i = i + 1
                    // skip to ')'
                    for _ in tokens {
                        if i < n and tokens[i].val != ")" {
                            i = i + 1
                        }
                    }
                    if i < n and tokens[i].val == ")" {
                        i = i + 1
                    }
                }
                if i < n and tokens[i].val == "{" {
                    let mut depth = 1
                    i = i + 1
                    for _ in tokens {
                        if i < n and depth > 0 {
                            if tokens[i].val == "{" {
                                depth = depth + 1
                            } else if tokens[i].val == "}" {
                                depth = depth - 1
                            }
                            i = i + 1
                        }
                    }
                }
                let while_id = next_id
                next_id = next_id + 1
                let while_node = empty_node(while_id, "while")
                nodes = nodes + [while_node]
                top_stmts = top_stmts + [while_id]
            } else if tok.kind == "ident" {
                // Assignment or function call: x = 5; or foo();
                let ident_name = tok.val
                i = i + 1
                if i < n and tokens[i].val == "=" {
                    i = i + 1
                    let assign_id = next_id
                    next_id = next_id + 1
                    let mut assign_node = empty_node(assign_id, "assign")
                    assign_node = {
                        id: assign_node.id,
                        kind: assign_node.kind,
                        str_val: ident_name,
                        num_val: assign_node.num_val,
                        bool_val: assign_node.bool_val,
                        op: "=",
                        left: -1,
                        right: -1,
                        extra: -1,
                        children: [],
                        args: []
                    }
                    nodes = nodes + [assign_node]
                    top_stmts = top_stmts + [assign_id]
                    if i < n and tokens[i].kind != ";" {
                        i = i + 1
                    }
                } else if i < n and tokens[i].val == "(" {
                    // Call
                    i = i + 1
                    for _ in tokens {
                        if i < n and tokens[i].val != ")" {
                            i = i + 1
                        }
                    }
                    if i < n and tokens[i].val == ")" {
                        i = i + 1
                    }
                    let call_id = next_id
                    next_id = next_id + 1
                    let mut call_node = empty_node(call_id, "call")
                    call_node = {
                        id: call_node.id,
                        kind: call_node.kind,
                        str_val: ident_name,
                        num_val: call_node.num_val,
                        bool_val: call_node.bool_val,
                        op: call_node.op,
                        left: call_node.left,
                        right: call_node.right,
                        extra: call_node.extra,
                        children: [],
                        args: []
                    }
                    nodes = nodes + [call_node]
                    top_stmts = top_stmts + [call_id]
                }
                if i < n and tokens[i].val == ";" {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        }
    }

    let root_id = next_id
    let mut root_node = empty_node(root_id, "block")
    root_node = {
        id: root_node.id,
        kind: root_node.kind,
        str_val: root_node.str_val,
        num_val: root_node.num_val,
        bool_val: root_node.bool_val,
        op: root_node.op,
        left: root_node.left,
        right: root_node.right,
        extra: root_node.extra,
        children: top_stmts,
        args: root_node.args
    }
    nodes = nodes + [root_node]

    {
        nodes: nodes,
        root_id: root_id
    }
}
