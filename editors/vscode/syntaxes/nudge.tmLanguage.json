{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nudge",
  "scopeName": "source.nudge",
  "patterns": [
    { "include": "#comments" },
    { "include": "#prompts" },
    { "include": "#strings" },
    { "include": "#money" },
    { "include": "#numbers" },
    { "include": "#constraints" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#contextual" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nudge",
          "match": "//.*$"
        }
      ]
    },
    "prompts": {
      "name": "string.quoted.triple.nudge",
      "begin": "llm\"\"\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.nudge" }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.nudge" }
      },
      "patterns": [
        {
          "name": "meta.interpolation.nudge",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.nudge",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nudge",
          "match": "\\\\."
        }
      ]
    },
    "money": {
      "name": "constant.numeric.money.nudge",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\s+USD\\b"
    },
    "numbers": {
      "name": "constant.numeric.nudge",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "constraints": {
      "patterns": [
        {
          "name": "storage.modifier.constraint.nudge",
          "match": "@[a-z_]+"
        }
      ]
    },
    "types": {
      "name": "support.type.primitive.nudge",
      "match": "\\b(string|float|int|bool)\\b"
    },
    "constants": {
      "name": "constant.language.nudge",
      "match": "\\b(true|false|none|LLM)\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nudge",
          "match": "\\b(if|else|for|in|return|test|assert)\\b"
        },
        {
          "name": "keyword.declaration.nudge",
          "match": "\\b(fn|let|type|tool|agent|state|export|use)\\b"
        },
        {
          "name": "keyword.operator.logical.nudge",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "keyword.other.parallel.nudge",
          "match": "\\b(par|map|all|race|uses|with)\\b"
        }
      ]
    },
    "contextual": {
      "name": "variable.parameter.nudge",
      "match": "\\b(schema|model|budget|retry|concurrency|replay|impl|zip)\\b"
    }
  }
}
