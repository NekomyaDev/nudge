{
  "LLM call with schema and budget": {
    "prefix": "llm",
    "body": [
      "let ${1:answer} = llm\"\"\"${2:prompt text}\"\"\" with {",
      "\tmodel: \"${3:fake}\",",
      "\tschema: ${4:MySchema},",
      "\tbudget: ${5:0.02} USD",
      "}"
    ],
    "description": "Structured LLM call with schema validation and a USD budget cap"
  },
  "Schema record type": {
    "prefix": "type",
    "body": [
      "type ${1:Name} = { ${2:field}: ${3:string} }"
    ],
    "description": "Record type used as an llm-call schema"
  },
  "Parallel map": {
    "prefix": "par",
    "body": [
      "let ${1:results} = par map(${2:items}, concurrency = ${3:3}) |${4:x}| -> ${5:work}(${4:x})"
    ],
    "description": "Bounded-concurrency parallel map"
  },
  "Function using LLM": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2}) -> ${3:string} uses LLM {",
      "\t${0}",
      "}"
    ],
    "description": "Function that is allowed to make LLM calls"
  },
  "Test block": {
    "prefix": "test",
    "body": [
      "test \"${1:description}\" {",
      "\tlet ${2:got} = ${3:call}",
      "\tassert ${2:got} == ${4:expected}",
      "}"
    ],
    "description": "Replayable test with assertions"
  }
}
