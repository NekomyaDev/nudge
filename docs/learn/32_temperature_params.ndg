fn extract_fact(article: string) -> string uses LLM {
    llm"""Extract the single most important factual claim from this article.

Article:
{article}

Return one concise sentence and do not add speculation.
"""
    with {
        model: "fake:default",
        budget: 0.01 USD,
        temperature: 0.1,
        top_p: 0.9,
        seed: 42
    }
}
