/// # 96/100 - Automatic secret redaction in trace logs
///
/// Sensitive data like passwords, API keys, and personal credentials must never leak into
/// trace files. Nudge traces automatically redact matched credential patterns.
///
/// Try:
///   nudgec check secret_redaction.ndg

fn sanitize_prompt(secret: string, prompt: string) -> string {
    "Redacted: " + prompt
}

fn main() -> string {
    sanitize_prompt("sk-secret-key-123", "User query")
}
