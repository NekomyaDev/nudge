/// # 130/140 - Bytecode inspection and compilation dumps
///
/// Inspect the raw instruction stream generated by the compiler to verify
/// optimizations, dead-code elimination, and constant propagation.
///
/// Try:
///   nudgec check bytecode_binary_dump.ndg

fn simple_calc(v: int) -> int {
    v * 2 + 1
}

fn main() -> int {
    simple_calc(10)
}
