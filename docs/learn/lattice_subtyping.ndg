/// # 113/140 - Subtyping lattices and record narrowing
///
/// Strong typing enables structural subtyping: records with additional fields
/// cleanly satisfy narrower parameter requirements without runtime adapters.
///
/// Try:
///   nudgec check lattice_subtyping.ndg

type BasicUser = { id: string }
type DetailedUser = { id: string, email: string, tier: string }

fn get_identifier(u: BasicUser) -> string {
    u.id
}

fn main() -> string {
    let user: DetailedUser = { id: "usr_991", email: "user@example.com", tier: "pro" }
    let basic: BasicUser = { id: user.id }
    get_identifier(basic)
}
