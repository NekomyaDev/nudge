/// # 63/140 - Peer authentication and security boundaries
///
/// Network-exposed agents must enforce caller identities. The `uses Auth` effect
/// binds authenticated bearer tokens to incoming task requests, rejecting unauthorized
/// cross-network execution before invoking model resources.
///
/// Try:
///   nudgec check a2a_auth_bearer.ndg
///   nudgec build a2a_auth_bearer.ndg

fn secure_query(token: string, query: string) -> string uses Auth, LLM {
    llm"""Process privileged user query: {query}"""
    with { model: "fake:default", budget: 0.01 USD }
}

fn main() -> string uses Auth, LLM {
    secure_query("bearer_token_abc", "list internal metrics")
}
