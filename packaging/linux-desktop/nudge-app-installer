                QMessageBox.information(window, "Kaldırıldı", f"'{app_info.title}' sisteminizden başarıyla kaldırıldı.")
            except Exception as ex:
                QMessageBox.critical(window, "Hata", f"Kaldırma sırasında hata oluştu:\n{ex}")

    def do_launch():
        window.close()
        NudgeAppManager.launch(app_info)

    btn_install.clicked.connect(do_install)
    btn_uninstall.clicked.connect(do_uninstall)
    btn_launch.clicked.connect(do_launch)

    btn_layout.addWidget(btn_uninstall)
    btn_layout.addWidget(btn_launch)
    btn_layout.addWidget(btn_install)

    root_layout.addLayout(btn_layout)

    window.show()
    sys.exit(qt_app.exec())


# ==============================================================================
# Tkinter Fallback GUI Implementation (Zero external Python dependencies)
# ==============================================================================
def run_tk_gui(app_info: NdgAppInfo):
    import tkinter as tk
    from tkinter import messagebox

    root = tk.Tk()
    root.title(f"Nudge Yükleyici — {app_info.title}")
    root.geometry("540x440")
    root.configure(bg="#1E202E")
    root.resizable(False, False)

    # Header
    lbl_title = tk.Label(root, text=app_info.title, font=("Helvetica", 16, "bold"), fg="#FFFFFF", bg="#1E202E")
    lbl_title.pack(pady=(20, 4))

    type_text = "🖥️ Masaüstü Uygulaması (GUI)" if app_info.is_gui else "⚡ Ajan / Terminal Uygulaması (CLI)"
    lbl_type = tk.Label(root, text=type_text, font=("Helvetica", 10), fg="#38BDF8" if app_info.is_gui else "#FBBF24", bg="#1E202E")
    lbl_type.pack(pady=(0, 15))

    # Card
    card = tk.Frame(root, bg="#282B3E", padx=16, pady=16)
    card.pack(fill="x", padx=20, pady=5)

    lbl_desc = tk.Label(card, text=app_info.description, font=("Helvetica", 10), fg="#CBD5E1", bg="#282B3E", wraplength=480, justify="left")
    lbl_desc.pack(anchor="w", pady=(0, 10))

    lbl_file = tk.Label(card, text=f"Dosya: {app_info.file_path.name}", font=("Helvetica", 9), fg="#94A3B8", bg="#282B3E")
    lbl_file.pack(anchor="w")

    st_txt = "Kurulum: ✓ Sistemde Kurulu" if app_info.is_installed else "Kurulum: ⚪ Henüz Kurulu Değil"
    lbl_status = tk.Label(card, text=st_txt, font=("Helvetica", 9, "bold"), fg="#34D399" if app_info.is_installed else "#94A3B8", bg="#282B3E")
    lbl_status.pack(anchor="w", pady=(4, 0))

    # Buttons Frame
    btn_frame = tk.Frame(root, bg="#1E202E", pady=20)
    btn_frame.pack(fill="x", padx=20, side="bottom")

    def tk_install():
        NudgeAppManager.install(app_info)
        messagebox.showinfo("Başarılı", f"'{app_info.title}' sisteme kuruldu!")
        root.destroy()

    def tk_launch():
        root.destroy()
        NudgeAppManager.launch(app_info)

    def tk_uninstall():
        if messagebox.askyesno("Onay", f"'{app_info.title}' sistemden kaldırılsın mı?"):
            NudgeAppManager.uninstall(app_info)
            messagebox.showinfo("Kaldırıldı", "Uygulama kaldırıldı.")
            root.destroy()

    tk.Button(btn_frame, text="Kapat", command=root.destroy, bg="#3B405A", fg="#FFFFFF", padx=10, pady=5).pack(side="left")

    if app_info.is_installed:
        tk.Button(btn_frame, text="Sistemden Kaldır", command=tk_uninstall, bg="#EF4444", fg="#FFFFFF", padx=10, pady=5).pack(side="right", padx=5)
    else:
        tk.Button(btn_frame, text="Sisteme Kur", command=tk_install, bg="#6366F1", fg="#FFFFFF", padx=10, pady=5).pack(side="right", padx=5)

    tk.Button(btn_frame, text="Çalıştır", command=tk_launch, bg="#10B981", fg="#FFFFFF", padx=10, pady=5).pack(side="right", padx=5)

    root.mainloop()


# ==============================================================================
# CLI / Main Entrypoint
# ==============================================================================
def main():
    parser = argparse.ArgumentParser(description="Nudge App Installer & Manager for Linux")
    parser.add_argument("file", nargs="?", help="Path to the .ndg application file")
    parser.add_argument("--install", action="store_true", help="Install application non-interactively")
    parser.add_argument("--uninstall", metavar="APP_ID", help="Uninstall an application by ID")
    parser.add_argument("--launch", action="store_true", help="Launch the application directly")
    parser.add_argument("--list", action="store_true", help="List installed Nudge applications")
    parser.add_argument("--setup", action="store_true", help="Register MIME types, desktop file associations, and icons")
    parser.add_argument("--cli", action="store_true", help="Force CLI mode without opening GUI window")

    args = parser.parse_args()

    if args.setup:
        NudgeAppManager.setup_system()
        return

    if args.list:
        installed = NudgeAppManager.list_installed()
        print(f"Sistemde kurulu Nudge uygulamaları ({len(installed)}):")
        for app in installed:
            print(f"  • {app['name']} [{app['id']}] -> {app['exec']}")
        return

    if args.uninstall:
        target_id = args.uninstall
        # Construct dummy info for uninstall
        class DummyInfo:
            app_id = target_id
            desktop_file_path = APPLICATIONS_DIR / f"{target_id}.desktop"
            installed_executable_path = BIN_DIR / target_id
            installed_app_dir = NUDGE_APPS_DIR / target_id
        NudgeAppManager.uninstall(DummyInfo())
        print(f"✓ '{target_id}' uygulaması sistemden kaldırıldı.")
        return

    if not args.file:
        parser.print_help()
        return

    target_path = Path(args.file)
    if not target_path.exists():
        print(f"Hata: Belirtilen dosya bulunamadı: {args.file}", file=sys.stderr)
        sys.exit(1)

    app_info = NdgAppInfo(target_path)

    if args.install:
        NudgeAppManager.install(app_info)
        print(f"✓ '{app_info.title}' uygulaması sisteme başarıyla kuruldu.")
        print(f"  Masaüstü girişi: {app_info.desktop_file_path}")
        print(f"  Komut: {app_info.installed_executable_path}")
        return

    if args.launch:
        NudgeAppManager.launch(app_info)
        return

    if args.cli:
        print(f"Uygulama: {app_info.title} ({app_info.version})")
        print(f"Tip: {'GUI' if app_info.is_gui else 'CLI'}")
        print(f"Açıklama: {app_info.description}")
        print(f"Yetkiler: {', '.join(sorted(app_info.effects)) or 'Yok'}")
        print(f"Kurulu mu: {'Evet' if app_info.is_installed else 'Hayır'}")
        return

    # Attempt PyQt6 first; fallback to Tkinter
    try:
        run_qt_gui(app_info)
    except ImportError:
        try:
            run_tk_gui(app_info)
        except ImportError:
            # Fallback to interactive terminal if no GUI libraries exist
            print(f"\n=== Nudge Uygulama Yükleyicisi ===")
            print(f"Uygulama: {app_info.title} (v{app_info.version})")
            print(f"Açıklama: {app_info.description}")
            print(f"Tip: {'GUI' if app_info.is_gui else 'CLI / Terminal'}")
            print(f"Yetkiler: {', '.join(sorted(app_info.effects)) or 'Yok'}")
            print(f"Durum: {'Sistemde Kurulu' if app_info.is_installed else 'Henüz Kurulu Değil'}\n")
            ans = input("Seçiminiz: [K]ur, [Ç]alıştır, [C]ıkış: ").strip().lower()
            if ans == 'k':
                NudgeAppManager.install(app_info)
                print(f"✓ Kuruldu!")
            elif ans == 'ç':
                NudgeAppManager.launch(app_info)

if __name__ == "__main__":
    main()
