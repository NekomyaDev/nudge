def slugify(text: str) -> str:
    s = text.lower().strip()
    s = re.sub(r'[\s_]+', '-', s)
    s = re.sub(r'[^a-z0-9\-]', '', s)
    return s.strip('-') or "nudge-app"

class NdgAppInfo:
    def __init__(self, file_path: Path):
        self.file_path = file_path.resolve()
        self.filename = file_path.name
        self.dir_path = self.file_path.parent
        self.content = ""
        try:
            self.content = self.file_path.read_text(encoding="utf-8", errors="replace")
        except Exception as e:
            self.content = ""

        self.title = ""
        self.description = ""
        self.version = "1.0.0"
        self.author = ""
        self.effects = set()
        self.is_gui = False
        self.window_title = ""
        self.custom_icon_path = None
        self._parse()

    def _parse(self):
        # 1. Parse comments at top of file
        lines = self.content.splitlines()
        desc_lines = []
        for line in lines[:25]:
            stripped = line.strip()
            if stripped.startswith("//") or stripped.startswith("#"):
                comment = stripped.lstrip("/# ").strip()
                if comment.lower().startswith("title:"):
                    self.title = comment.split(":", 1)[1].strip()
                elif comment.lower().startswith("version:"):
                    self.version = comment.split(":", 1)[1].strip()
                elif comment.lower().startswith("author:"):
                    self.author = comment.split(":", 1)[1].strip()
                elif comment.lower().startswith("description:"):
                    desc_lines.append(comment.split(":", 1)[1].strip())
                elif comment and not any(comment.lower().startswith(x) for x in ["http", "nudge", "copyright"]):
                    if len(desc_lines) < 3:
                        desc_lines.append(comment)
            elif stripped:
                break

        if desc_lines and not self.description:
            self.description = " ".join(desc_lines)

        # 2. Parse AST / keywords
        # Window / UI
        win_match = re.search(r'window\s+([A-Za-z0-9_]+)', self.content)
        title_match = re.search(r'title:\s*"([^"]+)"', self.content)
        if title_match:
            self.window_title = title_match.group(1).strip()
            if not self.title:
                self.title = self.window_title

        if re.search(r'\buses\s+[^;{]*\bUI\b', self.content) or win_match or "view " in self.content or ".open()" in self.content:
            self.is_gui = True

        # Agent name
        agent_match = re.search(r'agent\s+([A-Za-z0-9_]+)', self.content)
        if not self.title:
            if agent_match:
                # e.g. TriageAgent -> Triage Agent
                name = agent_match.group(1)
                self.title = re.sub(r'([a-z])([A-Z])', r'\1 \2', name)
            else:
                stem = self.file_path.stem
                self.title = stem.replace('-', ' ').replace('_', ' ').title()

        if not self.description:
            if self.is_gui:
                self.description = f"Nudge yerel masaüstü uygulaması ({self.title})"
            else:
                self.description = f"Nudge otonom ajan uygulaması ({self.title})"

        # Effects
        for effect in EFFECT_LABELS.keys():
            if re.search(rf'\buses\s+[^;{{]*\b{effect}\b', self.content):
                self.effects.add(effect)
        if self.is_gui:
            self.effects.add("UI")

        # Custom icon search
        for candidate in ["icon.svg", "icon.png", "logo.svg", "logo.png", "cover.jpg", "avatar.png"]:
            cand_path = self.dir_path / candidate
            if cand_path.is_file():
                self.custom_icon_path = cand_path
                break
            cand_assets = self.dir_path / "assets" / candidate
            if cand_assets.is_file():
                self.custom_icon_path = cand_assets
                break

    @property
    def app_id(self) -> str:
        base = slugify(self.title)
        if not base or base == "nudge-app":
            base = slugify(self.file_path.stem)
        if base.startswith("nudge-"):
            return base
        return f"nudge-{base}"

    @property
    def desktop_file_path(self) -> Path:
        return APPLICATIONS_DIR / f"{self.app_id}.desktop"

    @property
    def installed_app_dir(self) -> Path:
        return NUDGE_APPS_DIR / self.app_id

    @property
    def installed_executable_path(self) -> Path:
        return BIN_DIR / self.app_id

    @property
    def is_installed(self) -> bool:
        return self.desktop_file_path.exists() and self.installed_executable_path.exists()

class NudgeAppManager:
    @staticmethod
    def install(app: NdgAppInfo) -> bool:
        """Installs the .ndg application into standard XDG desktop environment."""
        NUDGE_APPS_DIR.mkdir(parents=True, exist_ok=True)
        APPLICATIONS_DIR.mkdir(parents=True, exist_ok=True)
        BIN_DIR.mkdir(parents=True, exist_ok=True)
        ICONS_DIR.mkdir(parents=True, exist_ok=True)

        target_dir = app.installed_app_dir
        target_dir.mkdir(parents=True, exist_ok=True)

        # 1. Copy source file
        target_file = target_dir / app.filename
        shutil.copy2(app.file_path, target_file)

        # 2. Copy sibling assets if present
        for sibling in ["assets", "traces", "trace.jsonl"]:
            sib_path = app.dir_path / sibling
            if sib_path.exists():
                dest = target_dir / sibling
                if sib_path.is_dir():
                    if dest.exists():
                        shutil.rmtree(dest)
                    shutil.copytree(sib_path, dest)
                else:
                    shutil.copy2(sib_path, dest)

        # 3. Handle Icon
        icon_name = app.app_id
        target_icon = ICONS_DIR / f"{icon_name}.svg"
        if app.custom_icon_path and app.custom_icon_path.suffix.lower() == ".svg":
            shutil.copy2(app.custom_icon_path, target_icon)
        elif app.custom_icon_path and app.custom_icon_path.suffix.lower() == ".png":
            png_dir = XDG_DATA_HOME / "icons" / "hicolor" / "512x512" / "apps"
            png_dir.mkdir(parents=True, exist_ok=True)
            shutil.copy2(app.custom_icon_path, png_dir / f"{icon_name}.png")
        else:
            target_icon.write_text(DEFAULT_NUDGE_SVG, encoding="utf-8")

        # 4. Create launcher wrapper script in ~/.local/bin
        wrapper_path = app.installed_executable_path
        wrapper_content = f"""#!/usr/bin/env bash
# Nudge Application Wrapper for {app.title}
APP_FILE="{target_file}"
cd "{target_dir}"
exec nudge-runner "$APP_FILE" --exec "$@"
"""
        wrapper_path.write_text(wrapper_content, encoding="utf-8")
        wrapper_path.chmod(0o755)

        # 5. Create .desktop entry
        terminal_flag = "false" if app.is_gui else "true"
        categories = "Utility;Development;"
        if app.is_gui:
            categories += "GUIDesigner;"

        desktop_content = f"""[Desktop Entry]
Version=1.0
Type=Application
Name={app.title}
Comment={app.description}
Exec={wrapper_path} %f
Icon={icon_name}
Terminal={terminal_flag}
Categories={categories}
MimeType=application/x-nudge;
StartupNotify=true
"""
        app.desktop_file_path.write_text(desktop_content, encoding="utf-8")

        # 6. Update desktop database
        try:
            subprocess.run(["update-desktop-database", str(APPLICATIONS_DIR)], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

        return True

    @staticmethod
    def uninstall(app: NdgAppInfo) -> bool:
        """Completely removes an installed .ndg application."""
        if app.desktop_file_path.exists():
            app.desktop_file_path.unlink()

        if app.installed_executable_path.exists():
            app.installed_executable_path.unlink()

        if app.installed_app_dir.exists():
            shutil.rmtree(app.installed_app_dir)

        # Remove icons
        for ext in [".svg", ".png"]:
            icon_file = ICONS_DIR / f"{app.app_id}{ext}"
            if icon_file.exists():
                icon_file.unlink()

        try:
            subprocess.run(["update-desktop-database", str(APPLICATIONS_DIR)], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

        return True

    @staticmethod
    def launch(app: NdgAppInfo):
        """Runs the application using nudge-runner."""
        file_to_run = str(app.file_path)
        if app.is_installed:
            installed_file = app.installed_app_dir / app.filename
            if installed_file.exists():
                file_to_run = str(installed_file)

        cmd = ["nudge-runner", file_to_run, "--exec"]
        subprocess.Popen(cmd)

    @staticmethod
    def list_installed():
        if not APPLICATIONS_DIR.exists():
            return []
        apps = []
        for dfile in APPLICATIONS_DIR.glob("nudge-*.desktop"):
            if dfile.name == "nudge-app-installer.desktop":
                continue
            content = dfile.read_text(encoding="utf-8", errors="replace")
            name_m = re.search(r'^Name=(.+)$', content, re.MULTILINE)
            exec_m = re.search(r'^Exec=(.+)$', content, re.MULTILINE)
            apps.append({
                "id": dfile.stem,
                "name": name_m.group(1) if name_m else dfile.stem,
                "desktop_file": str(dfile),
                "exec": exec_m.group(1) if exec_m else ""
            })
        return apps

    @staticmethod
    def setup_system():
        """Registers MIME types, icons, and launcher associations for the desktop environment."""
        APPLICATIONS_DIR.mkdir(parents=True, exist_ok=True)
        MIME_PACKAGES_DIR.mkdir(parents=True, exist_ok=True)
        ICONS_DIR.mkdir(parents=True, exist_ok=True)
        BIN_DIR.mkdir(parents=True, exist_ok=True)

        # MIME file
        mime_target = MIME_PACKAGES_DIR / "application-x-nudge.xml"
        mime_content = """<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
    <mime-type type="application/x-nudge">
        <comment>Nudge Agent Application</comment>
        <comment xml:lang="tr">Nudge Ajan Uygulaması</comment>
        <icon name="application-x-nudge"/>
        <generic-icon name="application-x-executable"/>
        <glob pattern="*.ndg"/>
        <sub-class-of type="text/plain"/>
    </mime-type>
</mime-info>"""
        mime_target.write_text(mime_content, encoding="utf-8")

        # Icons
        nudge_icon = ICONS_DIR / "nudge.svg"
        mime_icon = ICONS_DIR / "application-x-nudge.svg"
        nudge_icon.write_text(DEFAULT_NUDGE_SVG, encoding="utf-8")
        mime_icon.write_text(DEFAULT_NUDGE_SVG, encoding="utf-8")

        # Desktop entry for installer
        installer_desktop = APPLICATIONS_DIR / "nudge-app-installer.desktop"
        installer_desktop_content = f"""[Desktop Entry]
Version=1.0
Type=Application
Name=Nudge App Installer
Name[tr]=Nudge Uygulama Yükleyicisi
Comment=Install and run .ndg Nudge applications
Comment[tr]=.ndg Nudge uygulamalarını sisteme kurun veya doğrudan başlatın
Exec={BIN_DIR}/nudge-app-installer %f
Icon=nudge
Terminal=false
Categories=System;Utility;PackageManager;
MimeType=application/x-nudge;text/x-nudge;
StartupNotify=true
NoDisplay=false
"""
        installer_desktop.write_text(installer_desktop_content, encoding="utf-8")

        # Update databases
        subprocess.run(["update-mime-database", str(XDG_DATA_HOME / "mime")], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["update-desktop-database", str(APPLICATIONS_DIR)], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # Set default MIME handler
        subprocess.run(["xdg-mime", "default", "nudge-app-installer.desktop", "application/x-nudge"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("✓ Nudge Linux masaüstü ve dosya türü entegrasyonu başarıyla tamamlandı.")
        return True


